---
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';
import { pagePath } from '../lib/path';
import { SHARE, abs, jsonLd } from '../lib/seo';

interface Props {
	/** Titre complet : l'onglet, le résultat de recherche, la carte de partage */
	title?: string;
	description?: string;
	/** Image de partage, 1200 × 630, en JPG ou PNG (les réseaux ne lisent pas le SVG) */
	image?: string;
	imageAlt?: string;
	/** Page à tenir hors des moteurs de recherche (la 404) */
	noindex?: boolean;
	/** Données structurées de la page : des nœuds schema.org (lib/seo.ts) */
	schema?: object[];
}

const { title = site.seoTitle, description = site.description, image = SHARE.src, imageAlt = site.shareAlt, noindex = false, schema } = Astro.props;
const canonical = abs(pagePath(Astro.url));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#090c0a" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{
			noindex ? (
				<meta name="robots" content="noindex, follow" />
			) : (
				<>
					<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
					<link rel="canonical" href={canonical} />
				</>
			)
		}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={abs(image)} />
		<meta property="og:image:type" content={image.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
		<meta property="og:image:width" content={String(SHARE.width)} />
		<meta property="og:image:height" content={String(SHARE.height)} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={abs(image)} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<!-- Google ne lit pas le SVG pour l'icône des résultats : l'ICO et le PNG d'abord -->
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preload" href="/fonts/Parceh.otf" as="font" type="font/otf" crossorigin />
		{schema && !noindex && <script type="application/ld+json" is:inline set:html={jsonLd(schema)} />}

		<!-- Transition en mosaïque : si on arrive d'un clic, la page reste voilée
		     jusqu'à ce que les tuiles la révèlent (voile retiré seul après 2,5 s) -->
		<script is:inline>
			try {
				const r = JSON.parse(sessionStorage.getItem('hyphe:tiles') || 'null');
				if (r && Date.now() - r.t < 5000 && !matchMedia('(prefers-reduced-motion: reduce)').matches)
					document.documentElement.classList.add('tiles-cover');
				// Arrivée par le défilement infini : le haut de page est déjà en place
				const c = Number(sessionStorage.getItem('hyphe:continue'));
				sessionStorage.removeItem('hyphe:continue');
				if (c && Date.now() - c < 5000) document.documentElement.classList.add('continued');
			} catch {}
		</script>
	</head>
	<body>
		<a href="#main" class="meta sr-only z-[60] rounded bg-bone px-3 py-2 text-void focus:not-sr-only focus:fixed focus:left-4 focus:top-4">
			Skip to content
		</a>
		<Nav />
		<main id="main">
			<slot />
		</main>

		<script>
			import { mountAscii } from '../scripts/ascii';
			import { mountText } from '../scripts/text';
			import { mountTiles } from '../scripts/tiles';
			import { mountScroll } from '../scripts/scroll';
			import { mountSound } from '../scripts/sound';

			// Le son d'abord : il doit voir si l'on arrive d'une transition
			mountSound();
			mountScroll();
			// Les fleurs isolées (studio, pied de page) : three.js n'est chargé
			// qu'à l'approche de la première
			const specimens = document.querySelectorAll('canvas[data-specimen]');
			if (specimens.length) {
				const near = new IntersectionObserver(
					(entries) => {
						if (!entries.some((e) => e.isIntersecting)) return;
						near.disconnect();
						import('../scripts/specimen').then((m) => m.mountSpecimens());
					},
					{ rootMargin: '800px 0px' },
				);
				specimens.forEach((c) => near.observe(c));
			}
			mountTiles();
			mountText();
			mountAscii();

			// Les éléments marqués apparaissent en entrant dans la vue
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						const el = entry.target;
						el.classList.add('is-in');
						io.unobserve(el);
						// Safari laisse parfois des tuiles à mi-course sur l'image : une fois
						// l'animation passée (1,5 s au plus), le voile est retiré pour de bon
						if (el.matches('[data-tiles]')) setTimeout(() => el.classList.add('is-done'), 1800);
					}
				},
				{ threshold: 0.01 },
			);
			document.querySelectorAll('[data-reveal], [data-split], [data-tiles], mark.hl').forEach((el) => io.observe(el));

			// Quand le téléphone refuse la lecture automatique (économie d'énergie,
			// navigateur d'une appli), les vidéos restent sur leur image d'attente :
			// le premier toucher les relance, un geste suffit à l'autoriser
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const wake = () =>
					document.querySelectorAll<HTMLVideoElement>('video[data-motion]').forEach((v) => {
						if (v.paused) v.play().catch(() => {});
					});
				addEventListener('pointerdown', wake, { passive: true });
				addEventListener('touchend', wake, { passive: true });
			}

			// Signature du studio, pour qui regarde sous les feuilles (la console)
			const mono = 'font: 12px/1.35 ui-monospace, Consolas, monospace;';
			console.log(
				"%c Studio Hyphe %c\n\n    .:*:.\n   :* o *:\n    ':*:'\n      |\n     \\|\n      |/\n      |\n\n%cGrown by hand. Looking under the leaves?\nSay hello: hello@studiohyphe.com",
				`${mono} background: #c8f53c; color: #090c0a;`,
				`${mono} color: #c8f53c;`,
				`${mono} color: #e6e4dc;`,
			);
		</script>

		<!-- Mesure d'audience Cloudflare, sans cookie. En ligne seulement : le
		     serveur de dev ne doit pas compter nos propres visites. -->
		{
			import.meta.env.PROD && (
				<script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "85324afadc454ecbbeea5673e4f42dc6"}' />
			)
		}
	</body>
</html>
