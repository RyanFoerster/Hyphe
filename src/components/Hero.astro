---
// Le hero : la fleur au centre (rendue par World), le titre d'un seul bloc
// d'autre, les projets en orbite autour d'elle.
import { coverOf, projects } from '../data/projects';
import { site } from '../data/site';
---

<section class="hero relative h-[100svh] min-h-[620px]" data-hero aria-labelledby="hero-title">
	<!-- Secours sans WebGL : la fleur en ASCII -->
	<div class="fallback absolute inset-x-0 top-[12%] bottom-[46%] hidden" aria-hidden="true">
		<canvas class="mx-auto block h-full w-full max-w-md" data-ascii-deferred data-ascii-kind="flower" data-ascii-seed="9" data-ascii-size="12" data-ascii-accent="ember"></canvas>
	</div>

	<!-- Composition centrée : la fleur occupe le haut, le titre d'un seul bloc dessous -->
	<div class="title-block pointer-events-none absolute inset-x-4 z-[3] flex flex-col items-center text-center" data-hero-title>
		<!-- La tige s'arrête au-dessus du titre ; sous lui, ses racines en caractères -->
		<canvas class="roots pointer-events-none absolute left-1/2 top-2 -z-10 w-[min(760px,92vw)] -translate-x-1/2 opacity-60" data-ascii data-ascii-kind="roots" data-ascii-seed="21" data-ascii-size="10" aria-hidden="true"></canvas>
		<p class="meta mb-5 text-mineral" data-reveal style="--reveal-delay: 300ms">
			<span class="kicker" data-scramble>[ Specimen 001 ] Hyphae floralis — grown in {site.city}</span>
		</p>
		<!-- Le titre attend que les tuiles du loader soient passées pour germer (html.is-unveiling) -->
		<h1 id="hero-title" class="titre text-[clamp(2.7rem,6.2vw,7.4rem)] leading-[0.94]" data-split style="--split-delay: 150ms">
			<span class="block">Digital experiences,</span>
			<span class="block">grown differently.</span>
		</h1>
		<a href="#work" class="scroll-cue meta pointer-events-auto mt-6 hidden items-center gap-3 text-bone/70 transition hover:text-acid sm:flex" data-reveal style="--reveal-delay: 800ms">
			<span class="cue-line block h-px w-8 bg-bone/30" aria-hidden="true"></span>
			<span data-scramble>Scroll to enter the flower</span>
			<span class="cue-line block h-px w-8 bg-bone/30" aria-hidden="true"></span>
		</a>
	</div>

	<!-- Coin bas gauche : manifeste et statut -->
	<div class="pointer-events-none absolute inset-x-4 bottom-5 z-[3] flex items-end justify-between gap-6 sm:inset-x-6">
		<div class="pointer-events-auto max-w-[17rem] space-y-3" data-reveal style="--reveal-delay: 500ms">
			<p class="hidden text-[14px] leading-relaxed text-bone/70 lg:block">
				We design and build websites, interfaces and interactive worlds for brands that want to be
				<mark class="hl">felt</mark>, not just seen.
			</p>
			<p class="meta flex items-center gap-2 text-mineral">
				<span class="relative flex size-1.5">
					<span class="absolute inset-0 animate-ping rounded-full bg-acid/60"></span>
					<span class="relative size-1.5 rounded-full bg-acid"></span>
				</span>
				<span data-scramble>Open for projects — worldwide</span>
			</p>
			<p class="orbit-hint meta hidden text-mineral-dim">← drag to turn the orbit →</p>
		</div>
	</div>

	<!-- Les projets, en orbite autour de la fleur (positionnés par World) -->
	<ul class="orbit" aria-label="Selected work">
		{
			projects.map((p, i) => (
				<li>
					<a
						href={`/work/${p.slug}`}
						data-portal
						data-orbit-item
						data-accent={p.visual.accent}
						class="orbit-item glass group"
						aria-label={`${p.name} — ${p.category}, ${p.year}`}
					>
						<span data-portal-frame class="thumb">
							<img src={coverOf(p)} alt="" width="64" height="36" draggable="false" />
						</span>
						<span class="body">
							<span class="meta text-mineral">
								{String(i + 1).padStart(2, '0')} — {p.year}
							</span>
							<span class="name">{p.name}</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.hero[data-fallback] .fallback {
		display: block;
	}

	/* Sans le monde 3D : les projets en rangée sous la fleur */
	.orbit {
		position: absolute;
		inset-inline: 1rem;
		top: 52svh;
		z-index: 4;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}
	.orbit-item {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.3rem 0.85rem 0.3rem 0.3rem;
		border-radius: 10px;
		transition:
			border-color 0.4s,
			background-color 0.4s;
	}
	.orbit-item:hover,
	.orbit-item:focus-visible {
		border-color: rgb(200 245 60 / 0.45);
		background-color: color-mix(in oklab, var(--color-soil) 75%, transparent);
	}
	.thumb {
		display: block;
		width: 56px;
		height: 36px;
		overflow: hidden;
		border-radius: 6px;
		border: 1px solid rgb(230 228 220 / 0.1);
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 0.7s var(--ease-organic);
	}
	.orbit-item:hover .thumb img {
		scale: 1.3;
	}
	.body {
		display: flex;
		flex-direction: column;
		white-space: nowrap;
	}
	.name {
		font-size: 13px;
		line-height: 1.2;
		color: var(--color-bone);
	}
	@media (max-width: 767px) {
		.orbit-item {
			padding: 0.25rem;
		}
		.orbit-item .body {
			display: none;
		}
		.thumb {
			width: 44px;
			height: 30px;
		}
	}

	/* Avec le monde 3D : chaque carte est placée sur l'anneau */
	:global(html[data-world='on']) .orbit {
		position: static;
	}
	:global(html[data-world='on']) .orbit-item {
		position: fixed;
		left: 0;
		top: 0;
		opacity: 0;
		will-change: transform, opacity;
	}

	/* La scène s'attrape : pas de sélection de texte, curseur main */
	.hero {
		user-select: none;
		-webkit-user-select: none;
	}
	:global(html[data-world='on']) .hero {
		cursor: grab;
		touch-action: pan-y;
	}
	:global(html[data-world='on']) .orbit-hint {
		display: block;
	}
	:global(html[data-world='on']) .orbit-item {
		user-select: none;
		-webkit-user-select: none;
		touch-action: pan-y;
	}
	:global(html.orbit-grabbing),
	:global(html.orbit-grabbing *) {
		cursor: grabbing !important;
		user-select: none !important;
	}

	.title-block {
		--hx: 0;
		bottom: 7svh;
		isolation: isolate;
	}
	/* En quittant la surface, les lettres du titre s'envolent comme des spores
	   (--hx de 0 à 1, posé par World au début de la plongée) */
	.title-block h1 :global(.l) {
		translate: calc(var(--hx) * var(--o, 0) * 0.8em) calc(var(--hx) * (-0.3em - var(--j, 0) * 0.1em));
		opacity: calc(1 - var(--hx) * (0.5 + var(--j, 0) * 0.08));
		filter: blur(calc(var(--hx) * var(--j, 0) * 0.5px));
	}
	.roots {
		height: calc(100% + 7svh);
	}
	@media (max-width: 639px) {
		.title-block {
			bottom: 15svh;
		}
	}
	.cue-line {
		animation: cue 2.4s var(--ease-organic) infinite;
	}
	.cue-line:first-child {
		transform-origin: right;
	}
	.cue-line:last-child {
		transform-origin: left;
	}
	@keyframes cue {
		0%, 100% { scale: 0 1; }
		50% { scale: 1 1; }
	}
</style>
