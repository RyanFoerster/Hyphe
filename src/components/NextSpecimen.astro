---
// Fin de page projet : on continue de défiler et le spécimen suivant pousse.
// La scène finale est le hero de la page suivante, rendu à l'identique
// (ProjectHero en mode next) : au bout, on change de page sans que rien ne bouge.
import ProjectHero from './ProjectHero.astro';
import { projects, type Project } from '../data/projects';

interface Props {
	next: Project;
}

const { next } = Astro.props;
const no = String(projects.indexOf(next) + 1).padStart(2, '0');
const total = String(projects.length).padStart(2, '0');
---

<section class="next relative" aria-label={`Next project: ${next.name}`} data-next data-href={`/work/${next.slug}`}>
	<div class="stage sticky top-0 h-[100svh] overflow-hidden">
		<ProjectHero project={next} mode="next" />

		<!-- L'interface de la pousse : elle s'efface avant la fin -->
		<div class="ui pointer-events-none absolute inset-x-4 top-24 sm:inset-x-6" aria-hidden="true">
			<p class="meta flex justify-between text-mineral">
				<span>Keep scrolling — specimen {no} / {total}</span>
				<span class="tabular-nums text-acid" data-next-value>0.00000000</span>
			</p>
			<p class="meta mt-3 flex items-center gap-4 text-bone/70">
				<span class="tabular-nums" data-next-bar>[::::::::::::::::::::::::]</span>
				<span class="tabular-nums text-acid" data-next-pct>000%</span>
			</p>
			<svg class="mt-3 block h-5 w-full overflow-visible" viewBox="0 0 1000 24" preserveAspectRatio="none">
				<path d="M0 12 C 80 2, 140 22, 220 12 S 360 4, 430 13 S 560 22, 640 11 S 790 3, 860 12 S 960 20, 1000 12" pathLength="1" class="hypha" />
				<path d="M220 12 l 10 -10 M430 13 l -8 9 M640 11 l 9 -9 M860 12 l -7 9" pathLength="1" class="twig" />
			</svg>
		</div>
		<a href={`/work/${next.slug}`} class="enter meta absolute bottom-6 right-4 border border-bone/20 bg-void/60 px-3 py-2 text-bone backdrop-blur transition hover:border-acid hover:text-acid sm:right-6" data-next-enter>
			Enter {next.name} →
		</a>
	</div>
</section>

<style>
	.next {
		height: 260svh;
		--p: 0;
	}
	.ui,
	.enter {
		opacity: calc(1 - clamp(0, (var(--p) - 0.82) * 7, 1));
	}
	.hypha,
	.twig {
		fill: none;
		stroke: var(--color-acid);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
		stroke-dasharray: 1;
		stroke-dashoffset: calc(1 - var(--p));
	}
	.twig {
		stroke: rgb(230 228 220 / 0.6);
		stroke-dashoffset: calc(1 - clamp(0, (var(--p) - 0.4) * 1.6, 1));
	}
	@media (prefers-reduced-motion: reduce) {
		.next {
			height: auto;
			--p: 1;
		}
		.stage {
			position: relative;
		}
	}
</style>

<script>
	import { scrollToY } from '../scripts/scroll';

	const zone = document.querySelector<HTMLElement>('[data-next]');
	if (zone && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const href = zone.dataset.href!;
		const bar = zone.querySelector<HTMLElement>('[data-next-bar]')!;
		const pct = zone.querySelector<HTMLElement>('[data-next-pct]')!;
		const value = zone.querySelector<HTMLElement>('[data-next-value]')!;

		// La page suivante est préchargée dès que la zone approche
		new IntersectionObserver(
			([e], io) => {
				if (!e.isIntersecting) return;
				const link = document.createElement('link');
				link.rel = 'prefetch';
				link.href = href;
				document.head.append(link);
				io.disconnect();
			},
			{ rootMargin: '100% 0px' },
		).observe(zone);

		// Passage en continu : la page suivante s'ouvre sans rejouer son entrée
		const cross = () => {
			sessionStorage.setItem('hyphe:continue', String(Date.now()));
			location.href = href;
		};
		// Le bouton fait défiler jusqu'au bout plutôt que de couper la pousse
		zone.querySelector('[data-next-enter]')?.addEventListener('click', (e) => {
			e.preventDefault();
			e.stopPropagation();
			const top = zone.getBoundingClientRect().top + scrollY;
			scrollToY(top + zone.offsetHeight - innerHeight);
		});

		// On n'enchaîne que si le visiteur est vraiment descendu jusque-là
		// (pas au retour arrière, qui ramène directement en bas de page)
		let armed = false;
		let gone = false;
		let shown = 0;
		const tick = () => {
			const r = zone.getBoundingClientRect();
			const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
			if (p < 0.85) armed = true;
			shown += (p - shown) * 0.2;
			if (Math.abs(p - shown) < 0.001) shown = p;
			zone.style.setProperty('--p', shown.toFixed(4));
			const filled = Math.round(shown * 24);
			bar.textContent = `[${'#'.repeat(filled)}${':'.repeat(24 - filled)}]`;
			pct.textContent = `${String(Math.round(shown * 100)).padStart(3, '0')}%`;
			value.textContent = (shown + (shown > 0 && shown < 1 ? 0.00000001 : 0)).toFixed(8);
			// On attend que la scène soit posée (shown = 1) pour que le passage soit invisible
			if (armed && !gone && p >= 0.995 && shown >= 0.999) {
				gone = true;
				cross();
			}
			requestAnimationFrame(tick);
		};
		requestAnimationFrame(tick);
		addEventListener('pageshow', (e) => {
			if (e.persisted) {
				armed = false;
				gone = false;
			}
		});
	}
</script>
