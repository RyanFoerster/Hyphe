---
import Card from '~/components/ui/Card.astro';
import Latin from '~/components/ui/Latin.astro';
import type { Specimen } from '~/types/content';

interface Props {
  specimens: Specimen[];
  accent: string;
}

const { specimens, accent } = Astro.props;
---

<section class="rule-double mt-20 pt-8">
  <h2 class="titre-etiquette mb-7 text-2xs tracking-wider uppercase" style={`color:${accent}`}>
    Spécimens collectés
  </h2>
  <div class="grid grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-5">
    {
      specimens.map((s) => (
        <a href={`/herbier/${s.slug}`} class="block no-underline">
          <Card as="article" interactive class="px-4.5 py-4">
            <div class="mb-1.5 text-2xs tracking-wide text-spore">SPÉCIMEN Nº {s.num}</div>
            <Latin class="text-base !text-nat-100">{s.latin}</Latin>
            <div class="mt-1 text-2xs text-nat-400">{s.client}</div>
          </Card>
        </a>
      ))
    }
  </div>
</section>
