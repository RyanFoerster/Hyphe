---
import DualText from '~/components/ui/DualText.astro';
import type { EtapeFrise } from '~/types/content';

/** Parcours — une frise de croissance, pas un CV. */
interface Props {
  frise: EtapeFrise[];
  accent: string;
}

const { frise, accent } = Astro.props;
---

<section class="rule-double mt-20 pt-8">
  <h2 class="titre-etiquette mb-7 text-2xs tracking-wider uppercase" style={`color:${accent}`}>
    Parcours — frise de croissance
  </h2>
  <ol class="m-0 flex list-none flex-col gap-8 border-l border-nat-700 p-0">
    {
      frise.map((etape) => (
        <li class="relative pl-8">
          <span
            class="absolute -left-1 top-1.5 size-[7px] rounded-full"
            style={`background:${accent}`}
          />
          <div class="mb-1 text-2xs tracking-wide text-nat-400">{etape.annee}</div>
          <DualText
            as="block"
            nat={etape.nat}
            tel={etape.tel}
            nowrap={false}
            class="text-sm"
            natClass="font-display italic text-nat-200"
          />
        </li>
      ))
    }
  </ol>
</section>
