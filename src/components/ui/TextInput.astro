---
interface Props {
  name: string;
  type?: 'text' | 'email';
  placeholder?: string;
  required?: boolean;
}

const { name, type = 'text', placeholder, required = false } = Astro.props;
---

<input
  type={type}
  name={name}
  placeholder={placeholder}
  required={required}
  class="w-full box-border font-mono text-sm text-nat-100 bg-nat-900 border border-nat-700 rounded-input px-2.5 py-2 outline-none transition-shadow duration-fast ease-eco focus:border-tele-cyan focus:shadow-glow"
/>
