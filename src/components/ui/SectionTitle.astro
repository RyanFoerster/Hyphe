---
/** Titre de section — Fraunces, WONK actif, sur la rampe la plus claire. */
interface Props {
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const { as: Tag = 'h2', class: className = '' } = Astro.props;
---

<Tag class:list={['text-3xl text-nat-100', className]} data-reveler="titre">
  <slot />
</Tag>
