---
/** Eyebrow mono en majuscules espacées — la première ligne de chaque section. */
interface Props {
  class?: string;
  /** Couleur de l'étiquette ; ocre spore par défaut. */
  tone?: string;
}

const { class: className = '', tone = 'var(--color-spore)' } = Astro.props;
---

<div
  class:list={['text-2xs tracking-wider uppercase', className]}
  style={`color:${tone}`}
>
  <slot />
</div>
