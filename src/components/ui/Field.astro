---
/** Champ de formulaire : label mono en capitales, contrôle, puis indice. */
interface Props {
  label: string;
  name: string;
  hint?: string;
  class?: string;
}

const { label, name, hint = '', class: className = '' } = Astro.props;
---

<label class:list={['flex flex-col gap-1.5 font-mono', className]}>
  <span class="text-2xs tracking-wide uppercase text-nat-300">{label}</span>
  <slot />
  <span class="text-2xs text-nat-400" data-hint={name}>{hint}</span>
</label>
