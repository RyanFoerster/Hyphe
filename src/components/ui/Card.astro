---
import type { HTMLAttributes } from 'astro/types';

/** Carte = fond terreau + hairline + ombre discrète. Coins quasi carrés. */
interface Props extends HTMLAttributes<'div'> {
  /** Balise rendue — `article`, `section`… selon la sémantique du contenu. */
  as?: string;
  /** Ombre renforcée au survol, pour les cartes cliquables. */
  interactive?: boolean;
}

const { as: Tag = 'div', class: className = '', interactive = false, ...rest } = Astro.props;
---

<Tag
  {...rest}
  class:list={[
    'bg-bg-1 border border-nat-800 rounded-plate shadow-card',
    interactive && 'transition-shadow duration-base ease-eco hover:shadow-raised',
    className,
  ]}
>
  <slot />
</Tag>
