---
/**
 * Bouton — mono, majuscules espacées, coins d'input.
 * Survol : éclaircissement. Appui : assombrissement. Jamais de scale.
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md';
  type?: 'button' | 'submit';
  href?: string;
  class?: string;
}

const { variant = 'primary', size = 'md', type = 'button', href, class: className = '' } = Astro.props;

const variants = {
  primary:
    'bg-nat-500 text-bg-0 border border-transparent hover:bg-nat-400 active:bg-nat-600',
  secondary:
    'bg-transparent text-nat-200 border border-nat-700 hover:bg-bg-2 active:bg-nat-900',
  ghost:
    'bg-transparent text-nat-300 border border-transparent hover:text-nat-100 hover:bg-nat-900',
} as const;

const sizes = {
  sm: 'text-2xs px-3 py-1.5',
  md: 'text-xs px-[18px] py-[9px]',
} as const;

const classes = [
  'inline-flex items-center justify-center gap-2 font-mono tracking-wide uppercase rounded-input cursor-pointer no-underline',
  'transition-colors duration-fast ease-eco',
  variants[variant],
  sizes[size],
  className,
];

const Tag = href ? 'a' : 'button';
---

<Tag class:list={classes} href={href} type={href ? undefined : type}>
  <slot />
</Tag>
