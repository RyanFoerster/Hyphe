---
import SectionTitle from '~/components/ui/SectionTitle.astro';
import { identite, type PageLegale } from '~/data/legal';

interface Props {
  page: PageLegale;
}

const { page } = Astro.props;
---

<main class="mx-auto max-w-[720px] animate-route-in px-6 pt-[150px] pb-50 md:px-16">
  <SectionTitle as="h1" class="text-2xl">{page.titre}</SectionTitle>

  <div class="mt-10 flex flex-col gap-6 font-text text-base leading-body text-nat-200">
    <p class="m-0">{identite}</p>
    <p class="m-0">{page.corps}</p>
    <p class="m-0 text-xs text-nat-400">
      [Texte légal complet à valider avec votre conseil — placeholders à remplacer.]
    </p>
  </div>

  <div class="rule-double mt-14 pt-6">
    <a href="/" class="text-xs tracking-wide no-underline">← retour au terrain</a>
  </div>
</main>
