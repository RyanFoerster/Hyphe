---
import PlateFigure from '~/components/ui/PlateFigure.astro';
import type { Specimen } from '~/types/content';

/**
 * Bloc 1 — la planche principale bascule vers le schéma d'architecture :
 * ce qu'on regarde d'un côté, ce qui le fait tenir de l'autre.
 */
interface Props {
  specimen: Specimen;
}

const { specimen } = Astro.props;

const noeuds = [
  { titre: 'CLIENT WEB', detail: 'edge · SSR', tone: 'cyan' },
  { titre: 'API', detail: specimen.stack, tone: 'cyan' },
  { titre: 'DONNÉES', detail: 'persistance · sauvegardes', tone: 'cyan' },
  { titre: 'MONITORING', detail: `uptime ${specimen.uptime}`, tone: 'green' },
] as const;
---

<div
  class="relative overflow-hidden rounded-plate border shadow-card"
  style="border-color:color-mix(in oklab, var(--color-nat-700) calc(100% - var(--mixp)), var(--color-tele-cyan))"
>
  <PlateFigure
    src={specimen.planche}
    alt={`Aperçu du projet : ${specimen.livrable.label.toLowerCase()} pour ${specimen.client} (visuel provisoire : gravure du domaine public)`}
    ratio="aspect-[16/9]"
    caption="PLANCHE PRINCIPALE — [visuel projet à fournir] · gravure provisoire, domaine public"
    class="fade-nat"
    loading="eager"
    widths={[640, 960, 1280]}
    sizes="(max-width: 1000px) 100vw, 1000px"
  />

  <div
    aria-hidden="true"
    class="fade-tel pointer-events-none absolute inset-0 flex items-center justify-center bg-bg-1"
  >
    <div class="flex flex-wrap items-center justify-center gap-y-4 p-6">
      {
        noeuds.map((n, i) => (
          /* Le filet reste solidaire du nœud qu'il alimente : jamais orphelin en fin de ligne. */
          <div class="flex items-center">
            {i > 0 && (
              <div
                class="h-px w-14 shrink-0 opacity-50"
                style={`background:var(--color-tele-${n.tone === 'green' ? 'green' : 'cyan'})`}
              />
            )}
            <div
              class:list={[
                'rounded-input px-4 py-2.5 text-2xs tracking-wide',
                n.tone === 'green'
                  ? 'border border-dashed border-tele-green text-tele-green'
                  : 'border border-tele-cyan text-tele-cyan',
              ]}
            >
              {n.titre}
              <br />
              <span class="text-nat-400">{n.detail}</span>
            </div>
          </div>
        ))
      }
    </div>
    <div class="absolute bottom-3 left-4 text-2xs tracking-wide text-tele-cyan">
      SCHÉMA D'ARCHITECTURE — DERNIER DÉPLOIEMENT {specimen.prod}
    </div>
  </div>
</div>
