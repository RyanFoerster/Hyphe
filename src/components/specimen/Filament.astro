---
/** Le filament qui relie deux fiches — un fil de mycélium qui pend. */
interface Props {
  height?: string;
}

const { height = '88px' } = Astro.props;
---

<div
  aria-hidden="true"
  class="mx-auto mt-14 w-px"
  style={`height:${height}; background:linear-gradient(color-mix(in oklab, var(--color-tele-cyan) var(--mixp), var(--color-nat-600)), transparent 20%, color-mix(in oklab, var(--color-tele-cyan) var(--mixp), var(--color-nat-600)))`}
>
</div>
