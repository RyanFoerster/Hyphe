---
/**
 * Étiquette de bloc : le naturaliste nomme, l'instrument mesure.
 *
 * C'est un `h2` — chaque bloc d'une fiche est une section, et sans titre la
 * page entière ne présente qu'un seul repère à un lecteur d'écran. Le rôle
 * change, l'apparence non : `titre-etiquette` annule l'habit des titres.
 */
interface Props {
  nat: string;
  tel: string;
  accent?: string;
  class?: string;
}

const { nat, tel, accent = 'var(--color-spore)', class: className = '' } = Astro.props;
---

<h2 class:list={['titre-etiquette stack inline-grid text-2xs tracking-wider uppercase', className]}>
  <span class="fade-nat whitespace-nowrap" style={`color:${accent}`}>{nat}</span>
  <span class="fade-tel whitespace-nowrap text-tele-cyan" aria-hidden="true">{tel}</span>
</h2>
