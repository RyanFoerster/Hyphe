---
import type { Temoignage } from '~/types/content';

/** Bloc 7 — la citation encadrée d'un filet double ⇄ une ligne de log. */
interface Props {
  temoignage: Temoignage;
}

const { temoignage } = Astro.props;
---

<section class="mt-22">
  {/* L'unité de révélation est le STACK : les deux voix montent ensemble sous
    un seul masque. Taguer une couche seule animait l'aria-hidden en
    naturaliste et laissait le `src:` orphelin en télémétrie. */}
  <div class="stack" data-reveler="texte">
    <blockquote class="fade-nat m-0 border-l-[3px] border-double border-nat-700 pl-6">
      <p
        class="m-0 font-display text-xl italic leading-snug text-nat-100"
        style="font-variation-settings:'WONK' 1"
      >
        {temoignage.texte}
      </p>
      <footer class="mt-3.5 text-xs text-nat-300">
        — {temoignage.nom}, {temoignage.fonction}
      </footer>
    </blockquote>

    <blockquote
      class="fade-tel m-0 rounded-input border border-nat-800 bg-bg-1 px-6 py-5 text-xs text-nat-200"
      aria-hidden="true"
    >
      <p class="m-0">
        <span class="text-nat-400">[{temoignage.ts}]</span>
        <span class="text-tele-green">feedback.client</span> — {temoignage.texte}
      </p>
      <footer class="mt-2.5 text-nat-400">
        src: {temoignage.nom} · {temoignage.fonction}
      </footer>
    </blockquote>
  </div>
</section>
