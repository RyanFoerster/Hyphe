---
import BlocLabel from './BlocLabel.astro';
import PlateFigure from '~/components/ui/PlateFigure.astro';
import DualText from '~/components/ui/DualText.astro';
import type { Specimen } from '~/types/content';

/** Bloc 3 — écrans clés annotés ⇄ modules et routes. */
interface Props {
  specimen: Specimen;
}

const { specimen } = Astro.props;
---

<section class="rule-double mt-22 pt-8">
  <BlocLabel nat="Morphologie — écrans clés annotés" tel="Structure — modules et routes" class="mb-8" />

  <div class="grid items-center gap-10 lg:grid-cols-[minmax(300px,1.6fr)_minmax(220px,1fr)]">
    <PlateFigure
      src={specimen.planche}
      alt={`Écran clé du projet — ${specimen.livrable.label.toLowerCase()} (visuel provisoire)`}
      ratio="aspect-[4/3]"
      position="top"
      class="rounded-plate border border-nat-800 shadow-card transition-opacity duration-400 ease-eco"
      style="opacity:calc(1 - var(--mix) * 0.55)"
      widths={[480, 800]}
      sizes="(max-width: 1000px) 100vw, 620px"
    />

    {/* Les annotations appartiennent à la planche : sans ça, elles flottent
        à côté d'un cadre encore invisible — l'échafaudage inverse. */}
    <div class="flex flex-col gap-7" data-reveler="texte">
      {
        specimen.morpho.map((m) => (
          <DualText
            as="block"
            nat={m.nat}
            tel={m.tel}
            nowrap={false}
            class="border-l border-nat-700 pl-4 text-xs leading-normal"
            natClass="font-display italic text-nat-300"
          />
        ))
      }
    </div>
  </div>
</section>
