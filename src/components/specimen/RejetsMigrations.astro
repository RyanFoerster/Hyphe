---
import BlocLabel from './BlocLabel.astro';
import type { Specimen } from '~/types/content';

/** Bloc 5 — ce qu'on a jeté ⇄ ce qui a cassé. Les deux se disent. */
interface Props {
  specimen: Specimen;
}

const { specimen } = Astro.props;
---

<section class="rule-double mt-22 pt-8">
  <BlocLabel nat="Spécimens rejetés" tel="Journal des migrations" class="mb-6" />

  <div class="stack">
    <ol class="fade-nat m-0 flex list-none flex-col gap-3.5 p-0">
      {
        specimen.rejets.map((t) => (
          <li
            class="border-l border-nat-900 pl-4 font-display text-base italic text-nat-400"
            style="font-variation-settings:'WONK' 1"
          >
            {t}
          </li>
        ))
      }
    </ol>

    <ol class="fade-tel m-0 flex list-none flex-col gap-3.5 p-0" aria-hidden="true">
      {
        specimen.migrations.map((t) => (
          <li class="border-l border-nat-800 pl-4 text-xs text-nat-300">
            <span class="text-tele-coral">▲</span> {t}
          </li>
        ))
      }
    </ol>
  </div>
</section>
