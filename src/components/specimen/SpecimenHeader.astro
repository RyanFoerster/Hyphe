---
import SectionTitle from '~/components/ui/SectionTitle.astro';
import type { Specimen } from '~/types/content';

/**
 * Le titre et le résumé — sous le cartouche-page, qui porte désormais la
 * planche, le numéro, le tag et le latin (continuité avec le fruit).
 */
interface Props {
  specimen: Specimen;
}

const { specimen } = Astro.props;
---

<header class="mt-10">
  <SectionTitle as="h1" class="text-2xl md:text-3xl">{specimen.nom}</SectionTitle>
  <p data-reveler="texte" class="mt-4 mb-0 max-w-[40em] text-nat-300">{specimen.resume}</p>
</header>
