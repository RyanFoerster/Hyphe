---
import DualText from '~/components/ui/DualText.astro';
import Latin from '~/components/ui/Latin.astro';
import PlancheArchitecture from './PlancheArchitecture.astro';
import type { Specimen } from '~/types/content';

/**
 * Le cartouche-page : l'en-tête de la fiche est LE MÊME layout que le fruit
 * de l'arbre, à grande échelle — cadre à double filet, numéro en haut à
 * droite, planche 16/9, tag littéral puis nom latin — le même vocabulaire
 * d'une page à l'autre, sans transition à orchestrer.
 */
interface Props {
  specimen: Specimen;
}

const { specimen } = Astro.props;
---

<div
  class="relative rounded-[3px] border bg-bg-1 p-3 shadow-card sm:p-4"
  style="border-color:var(--color-nat-100)"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-[5px] rounded-[2px] border opacity-55"
    style="border-color:var(--color-nat-100)"
  >
  </div>

  <div class="relative mb-3 flex items-baseline justify-between gap-4 text-2xs tracking-wide">
    <DualText
      nat={`COLLECTE — ${specimen.collecte} · CLIENT — ${specimen.client}`}
      tel={`SVC ${specimen.slug} · STACK ${specimen.stack} · UPTIME ${specimen.uptime}`}
      nowrap={false}
      class="text-nat-300"
    />
    <span class="flex-none font-mono tracking-[0.1em] text-nat-300">
      Nº {specimen.num}
    </span>
  </div>

  <div class="relative">
    <PlancheArchitecture specimen={specimen} />
  </div>

  <div class="relative mt-3.5 flex flex-col items-center gap-1 text-center">
    <span class="font-mono text-xs tracking-wider uppercase text-nat-100">
      {specimen.livrable.label}
    </span>
    <Latin class="text-xl">{specimen.latin}</Latin>
  </div>
</div>
