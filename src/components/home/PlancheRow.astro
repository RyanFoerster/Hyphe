---
import PlateFigure from '~/components/ui/PlateFigure.astro';
import LivrableTag from '~/components/ui/LivrableTag.astro';
import PlancheAnnotation from './PlancheAnnotation.astro';
import DualText from '~/components/ui/DualText.astro';
import { annotationsPlanche } from '~/data/annotations';
import type { Specimen } from '~/types/content';

interface Props {
  specimen: Specimen;
}

const { specimen } = Astro.props;
const label = specimen.nom.replace(/^\[|\]$/g, '');
const href = `/herbier/${specimen.slug}`;
const telemeta = `STACK ${specimen.stack} · BUNDLE ${specimen.bundle} · LIGHTHOUSE ${specimen.lighthouse}`;
---

<article class="pt-7">
  {/* Le filet double se TRACE au lieu d'être une bordure : une bordure est là
      avant tout le monde, et quatre doubles lignes scandaient du vide. */}
  <span aria-hidden="true" data-reveler="filet" class="block" style="border-top:var(--rule-double)"></span>
  <div data-reveler="texte" class="mt-7 mb-7 flex flex-wrap justify-between gap-4 text-2xs tracking-wide">
    <span class="flex items-center gap-3">
      <span class="text-spore">SPÉCIMEN Nº {specimen.num}</span>
      <LivrableTag livrable={specimen.livrable} />
    </span>
    <DualText
      nat={`COLLECTE — ${specimen.collecte} · CLIENT — ${specimen.client}`}
      tel={telemeta}
      nowrap={false}
      class="justify-items-end text-right text-nat-300"
    />
  </div>

  <div
    class="grid items-center gap-7 lg:grid-cols-[minmax(180px,1fr)_minmax(320px,2.4fr)_minmax(180px,1fr)]"
  >
    <div class="hidden flex-col gap-11 lg:flex" data-reveler="texte">
      <PlancheAnnotation annotation={annotationsPlanche[0]!} align="right" />
      <PlancheAnnotation annotation={annotationsPlanche[1]!} align="right" />
    </div>

    <a href={href} class="block no-underline" aria-label={`Ouvrir la fiche du spécimen ${specimen.num}`}>
      <PlateFigure
        src={specimen.planche}
        alt={`${specimen.livrable.label} réalisé pour ${specimen.client} — planche du projet ${label} (visuel provisoire : gravure du domaine public)`}
        caption={`[${label}] · prélever →`}
        class="rounded-plate border shadow-card transition-shadow duration-base ease-eco hover:shadow-raised"
        style="border-color:color-mix(in oklab, var(--color-nat-700) calc(100% - var(--mixp)), var(--color-tele-cyan))"
      />
    </a>

    <div class="hidden flex-col gap-11 lg:flex" data-reveler="texte">
      <PlancheAnnotation annotation={annotationsPlanche[2]!} align="left" />
      <PlancheAnnotation annotation={annotationsPlanche[3]!} align="left" />
    </div>
  </div>
</article>
