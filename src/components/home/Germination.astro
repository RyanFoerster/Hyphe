---
import Section from './Section.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import { notes } from '~/data/manifesto';
---

<Section
  id="germination"
  stage={1}
  label="Germination"
  class="mx-auto max-w-[760px] px-6 pt-36 pb-40 md:px-16"
>
  <Eyebrow class="mb-4">Manifesto — stade II · germination</Eyebrow>
  <SectionTitle class="max-w-[14em] text-2xl md:text-3xl">
    Notes d'intention, relevées sur le terrain
  </SectionTitle>

  {/*
    Le rail se TRACE au lieu d'être une bordure — une bordure serait là avant
    tout le monde. Sa couleur passe par une classe : GSAP n'écrit que des
    transforms, mais rien de ce qui décide de l'apparence au repos ne doit
    vivre sur un élément qu'il manipule.

    Le retrait, lui, est porté par le PARAGRAPHE, pas par le conteneur animé :
    l'annotation garde sa marge, la puce reste calée sur le rail, et la mise en
    page au repos ne dépend d'aucun élément que le moteur transporte.
  */}
  <div class="relative mt-14 flex flex-col gap-14">
    <span
      aria-hidden="true"
      data-reveler="filet"
      class="absolute top-0 left-0 h-full w-px bg-nat-700"></span>
    {
      notes.map((note) => (
        <div data-reveler="texte" class="relative max-w-[34em]">
          <span
            class="absolute top-1.5 -left-1 size-[7px] rounded-full"
            style={`background:${note.puce}`}
          />
          <p
            class="m-0 font-text text-lg leading-body text-nat-200"
            style={`margin-left:${note.retrait}`}
          >
            {note.texte}
          </p>
        </div>
      ))
    }
  </div>
</Section>
