---
import Section from './Section.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import { notes } from '~/data/manifesto';
---

<Section
  id="germination"
  stage={1}
  label="Germination"
  class="mx-auto max-w-[760px] px-6 pt-36 pb-40 md:px-16"
>
  <Eyebrow class="mb-4">Manifesto — stade II · germination</Eyebrow>
  <SectionTitle class="max-w-[14em] text-2xl md:text-3xl">
    Notes d'intention, relevées sur le terrain
  </SectionTitle>

  <div class="mt-14 flex flex-col gap-14 border-l border-nat-700">
    {
      notes.map((note) => (
        <div class="relative max-w-[34em]" style={`padding-left:${note.retrait}`}>
          <span
            class="absolute -left-1 top-1.5 size-[7px] rounded-full"
            style={`background:${note.puce}`}
          />
          <p data-reveler="texte" class="m-0 font-text text-lg leading-body text-nat-200">{note.texte}</p>
        </div>
      ))
    }
  </div>
</Section>
