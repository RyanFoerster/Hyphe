---
import Section from './Section.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import { notes } from '~/data/manifesto';
---

<Section
  id="germination"
  stage={1}
  label="Germination"
  class="mx-auto max-w-[760px] px-6 pt-36 pb-40 md:px-16"
>
  <Eyebrow class="mb-4">Manifesto — stade II · germination</Eyebrow>
  <SectionTitle class="max-w-[14em] text-2xl md:text-3xl">
    Notes d'intention, relevées sur le terrain
  </SectionTitle>

  {/* Le rail n'est plus une bordure : une bordure est là avant tout le monde,
      alors qu'un rail se TRACE — même trait de plume que les filets, dressé.
      Et chaque note embarque sa puce dans son masque : rien d'elle n'existe
      avant son tour. */}
  <div class="relative mt-14 flex flex-col gap-14">
    <span
      aria-hidden="true"
      data-reveler="filet"
      class="absolute top-0 left-0 h-full w-px"
      style="background:var(--color-nat-700)"></span>
    {
      notes.map((note) => (
        <div
          data-reveler="texte"
          class="relative max-w-[34em]"
          style={`padding-left:${note.retrait}`}
        >
          <span
            class="absolute top-1.5 -left-1 size-[7px] rounded-full"
            style={`background:${note.puce}`}
          />
          <p class="m-0 font-text text-lg leading-body text-nat-200">{note.texte}</p>
        </div>
      ))
    }
  </div>
</Section>
