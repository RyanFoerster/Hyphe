---
import Section from './Section.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import DualText from '~/components/ui/DualText.astro';
import Button from '~/components/ui/Button.astro';
import SiteFooter from '~/components/chrome/SiteFooter.astro';
---

<Section
  id="pollinisation"
  stage={6}
  label="Pollinisation"
  class="relative flex min-h-[90vh] flex-col items-center justify-center px-6 pt-30 pb-20 text-center"
>
  <Eyebrow class="mb-5">Contact — stade VII · pollinisation</Eyebrow>

  <h2 class="max-w-[12em] text-[clamp(44px,7vw,84px)] text-nat-100">
    Semons quelque chose ensemble.
  </h2>

  <p data-reveler="texte" class="mt-6 mb-0 max-w-[30em] font-mono text-base leading-body text-nat-200">
    Décrivez votre projet — site web, application ou mission design — et
    recevez un devis sous 24 h ouvrées.
  </p>
  <DualText
    as="block"
    nat="Un mail suffit. On s'occupe de la germination."
    tel="Canal ouvert. Latence de réponse observée : < 24 h."
    nowrap={false}
    class="mt-3 w-full justify-items-center text-sm text-nat-300"
  />

  <div class="mt-10 flex flex-col items-center gap-4.5">
    <Button href="/pollinisation">Demander un devis</Button>
    <div class="text-2xs tracking-wide text-nat-400">
      BIOMASSE ACCUMULÉE PENDANT VOTRE VISITE —{' '}
      <span
        data-biomass
        style="color:color-mix(in oklab, var(--color-tele-green) var(--mixp), var(--color-spore))">0</span
      > unités
    </div>
  </div>

  <SiteFooter position="absolute" />
</Section>
