---
import Section from './Section.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import Card from '~/components/ui/Card.astro';
import { offres } from '~/data/offres';
---

<Section
  id="cultures"
  stage={2}
  label="Nos offres"
  class="mx-auto max-w-[1060px] px-6 pt-30 pb-40 md:px-16"
>
  <Eyebrow class="mb-4">Nos offres — stade III · cultures</Eyebrow>
  <SectionTitle class="text-2xl md:text-3xl">Ce qu'on cultive</SectionTitle>
  <p data-reveler="texte" class="mt-4 mb-14 max-w-[44em] text-nat-300">
    Trois façons de travailler avec nous. Chaque variété mène aux projets déjà
    livrés dans cette famille.
  </p>

  <div class="grid gap-6 md:grid-cols-3" data-reveler="groupe">
    {
      offres.map((offre) => (
        <a href={offre.href} class="block no-underline">
          <Card as="article" interactive class="flex h-full flex-col gap-3 px-6 py-7">
            {/* La nomenclature poétique est l'annotation — jamais le titre. */}
            <div class="stack text-2xs tracking-wider uppercase">
              <span class="fade-nat text-spore">{offre.poetique}</span>
              <span class="fade-tel text-tele-cyan" aria-hidden="true">{offre.tel}</span>
            </div>

            <h3 class="text-xl text-nat-100">{offre.titre}</h3>
            <div class="text-xs tracking-wide uppercase text-nat-300">{offre.detail}</div>

            <p class="m-0 flex-1 text-sm leading-body text-nat-200">{offre.phrase}</p>

            <div class="stack mt-2 border-t border-nat-800 pt-3 text-2xs tracking-wide">
              <span class="fade-nat text-nat-400">
                {offre.delai ? `Délai indicatif — ${offre.delai}` : 'Mission courte ou continue'}
              </span>
              <span class="fade-tel text-tele-cyan" aria-hidden="true">STACK — {offre.stacks}</span>
            </div>

            <span class="text-2xs tracking-wide text-nat-300">voir les projets de ce type →</span>
          </Card>
        </a>
      ))
    }
  </div>
</Section>
