---
import Card from '~/components/ui/Card.astro';
import Latin from '~/components/ui/Latin.astro';
import type { Espece } from '~/types/content';

interface Props {
  espece: Espece;
  numero: string;
  accent: string;
}

const { espece, numero, accent } = Astro.props;
const href = `/espece/${espece.slug}`;

const releves = [
  { dt: 'Habitat', dd: espece.habitat },
  { dt: 'Régime alimentaire', dd: espece.regime },
  { dt: 'Comportement observé', dd: espece.comportement },
  { dt: 'Période d’activité', dd: espece.activite },
];
---

<Card as="article" data-espece class="px-9 py-8 transition-opacity duration-300 ease-eco">
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <div>
      <div class="mb-2 text-2xs tracking-wider uppercase" style={`color:${accent}`}>
        {espece.eyebrow}
      </div>
      <h3 class="text-2xl text-nat-100">
        <a href={href} class="text-inherit no-underline hover:text-inherit">{espece.nom}</a>
      </h3>
      <div class="mt-1">
        <Latin>{espece.latin}</Latin>{' '}
        <span class="font-mono text-2xs not-italic text-nat-400">{espece.annee}</span>
      </div>
    </div>
    <a href={href} class="text-2xs tracking-wide text-nat-400 no-underline">
      SPÉCIMEN Nº {numero} · fiche →
    </a>
  </div>

  <dl class="mt-7 grid grid-cols-[repeat(auto-fit,minmax(210px,1fr))] gap-x-8 gap-y-5">
    {
      releves.map((r) => (
        <div>
          <dt class="mb-1.5 text-2xs tracking-wider uppercase text-nat-300">{r.dt}</dt>
          <dd class="m-0 text-nat-200">{r.dd}</dd>
        </div>
      ))
    }
  </dl>
</Card>
