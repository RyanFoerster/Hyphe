---
import DualText from '~/components/ui/DualText.astro';
import type { DualLabel } from '~/types/content';

/** Annotation de marge : un filet, puis la note — au crayon ou au capteur. */
interface Props {
  annotation: DualLabel;
  align: 'left' | 'right';
}

const { annotation, align } = Astro.props;
---

<div class:list={['text-xs leading-normal', align === 'right' ? 'text-right' : 'text-left']}>
  <span class="mb-1.5 block border-b border-nat-700 pb-1.5"></span>
  <DualText
    as="block"
    nat={annotation.nat}
    tel={annotation.tel}
    nowrap={false}
    class:list={[align === 'right' ? 'justify-items-end' : 'justify-items-start']}
    natClass="font-display italic text-nat-300"
  />
</div>
