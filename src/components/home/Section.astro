---
/** Enveloppe de section de la page d'accueil : ancre + stade observé par le rail. */
interface Props extends astroHTML.JSX.HTMLAttributes {
  id: string;
  stage: number;
  label: string;
  class?: string;
}

const { id, stage, label, class: className = '', ...reste } = Astro.props;
---

<section id={id} data-stage={stage} aria-label={label} class:list={[className]} {...reste}>
  <slot />
</section>
