---
import Section from './Section.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import EspeceCard from './EspeceCard.astro';
import NutrientExchange from './NutrientExchange.astro';
import { especes, especeAccent } from '~/data/especes';
---

<Section
  id="symbiose"
  stage={3}
  label="Symbiose"
  class="symbiose mx-auto max-w-[1060px] px-6 pt-30 pb-40 md:px-16"
>
  <Eyebrow class="mb-4">Le duo — stade IV · symbiose</Eyebrow>
  <SectionTitle class="text-2xl md:text-3xl">Deux espèces, un organisme</SectionTitle>
  <p data-reveler="texte" class="mt-4 mb-16 max-w-[44em] text-nat-300">
    Le studio, c'est deux personnes : une designer UX/UI et un développeur
    fullstack. Relevé de terrain — isolez un spécimen au survol : observez
    l'autre.
  </p>

  <EspeceCard espece={especes.designer} numero="A-01" accent={especeAccent('designer')} />
  <NutrientExchange />
  <EspeceCard espece={especes.dev} numero="B-01" accent={especeAccent('dev')} />
</Section>
