---
import DualText from '~/components/ui/DualText.astro';

/** Le filament entre les deux espèces : des nutriments montent, d'autres descendent. */
const particules = [
  { sens: 'up', duree: '2.6s', delai: '0s', teinte: 'var(--color-tele-green)', repos: 'var(--color-spore)' },
  { sens: 'down', duree: '2.2s', delai: '0.6s', teinte: 'var(--color-tele-cyan)', repos: 'var(--color-nat-400)' },
  { sens: 'up', duree: '3s', delai: '1.2s', teinte: 'var(--color-tele-green)', repos: 'var(--color-spore)' },
  { sens: 'down', duree: '2.8s', delai: '0.3s', teinte: 'var(--color-tele-cyan)', repos: 'var(--color-nat-400)' },
];
---

<div aria-hidden="true" class="relative flex h-20 items-center justify-center gap-9 overflow-hidden">
  <DualText
    nat="échange de nutriments"
    tel="flux bidirectionnel — 12 ms"
    class="text-2xs tracking-wider uppercase text-nat-400"
  />
  <span class="flex gap-[22px]">
    {
      particules.map((p) => (
        <span
          class="size-1 rounded-full"
          style={`background:color-mix(in oklab, ${p.teinte} var(--mixp), ${p.repos}); animation:${p.sens === 'up' ? 'nutrientUp' : 'nutrientDown'} ${p.duree} linear ${p.delai} infinite`}
        />
      ))
    }
  </span>
</div>
