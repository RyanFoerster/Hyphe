---
// Après la galerie : le studio remonte par-dessus la fleur éteinte.
// Un manifeste, puis ce que l'on fait pousser, accroché aux pétales d'une
// fleur vue d'en haut (la même que celle du hero).
import { site } from '../data/site';

---

<section class="studio relative z-10 overflow-hidden bg-void" aria-labelledby="studio-title">
	<div class="grid gap-8 px-4 pb-16 pt-32 sm:px-6 md:grid-cols-12 md:pb-20 md:pt-44">
		<p class="meta md:col-span-3" data-reveal><span class="kicker" data-scramble>[ 02 ] The studio</span></p>
		<div class="md:col-span-9">
			<h2 id="studio-title" class="sr-only">The studio</h2>
			<p class="text-[clamp(1.6rem,3.2vw,3rem)] leading-[1.12] tracking-[-0.01em] text-bone" data-reveal>
				Hyphae are the threads a fungus grows to find, connect and feed. We work the same way: patiently, below the surface,
				until something <mark class="hl">blooms</mark>.
			</p>
			<p class="meta mt-8 text-mineral" data-reveal style="--reveal-delay: 120ms">
				Independent studio — {site.city}, working worldwide
			</p>
		</div>
	</div>

	<!-- Ce que l'on fait pousser : un savoir-faire au bout de chaque pétale -->
	<div class="px-4 pb-32 sm:px-6 md:pb-44">
		<p class="meta mb-4 text-center" data-reveal><span class="kicker" data-scramble>What we grow</span></p>
		<div class="corolla relative -mx-4 sm:-mx-6" data-corolla>
			<canvas class="absolute inset-0 size-full" data-specimen="corolla" aria-hidden="true"></canvas>
			<ul>
				{
					site.services.map((s, i) => (
						<li class="label" data-petal-label tabindex="0" aria-label={`${s.name}: ${s.text}`}>
							<span class="node" aria-hidden="true" />
							<span class="tag meta" aria-hidden="true">
								<span class="text-acid">{String(i + 1).padStart(2, '0')}</span>
								<span class="tag-name">{s.name}</span>
							</span>
							<span class="card" aria-hidden="true">
								<span class="tick left-0 top-0 border-l border-t" />
								<span class="tick right-0 top-0 border-r border-t" />
								<span class="tick bottom-0 left-0 border-b border-l" />
								<span class="tick bottom-0 right-0 border-b border-r" />
								<span class="meta flex justify-between gap-4 text-mineral">
									<span>petal.{String(i + 1).padStart(2, '0')}</span>
									<span>{String(i + 1).padStart(2, '0')} / {String(site.services.length).padStart(2, '0')}</span>
								</span>
								<span class="titre mt-4 block text-[2.1rem] text-bone">{s.name}</span>
								<span class="mt-3 block text-[14px] leading-relaxed text-bone/75">{s.text}</span>
								<span class="meta mt-4 flex flex-wrap gap-x-3 gap-y-1 text-bone/60">
									{s.items.map((it) => (
										<span>
											<span class="text-acid">+</span> {it}
										</span>
									))}
								</span>
							</span>
						</li>
					))
				}
			</ul>
		</div>

		<div class="mt-16 flex justify-center" data-reveal>
			<button type="button" data-open-about class="about meta inline-flex items-center gap-3 border border-bone/20 px-5 py-2.5 text-bone transition hover:border-acid hover:text-acid">
				<span>About the studio</span><span aria-hidden="true">→</span>
			</button>
		</div>
	</div>
</section>

<style>
	/* ---- La corolle des savoir-faire ---- */
	.corolla {
		height: min(760px, 92vw);
	}
	/* Au bout de chaque pétale : un repère carré, un numéro, un nom */
	.label {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		opacity: 0;
		outline: none;
		will-change: transform;
	}
	.label[data-side='left'] {
		flex-direction: row-reverse;
	}
	.node {
		position: relative;
		flex: none;
		width: 9px;
		height: 9px;
		border: 1px solid var(--color-acid);
		transition:
			background-color 0.3s,
			scale 0.4s var(--ease-organic);
	}
	.tag {
		white-space: nowrap;
		color: rgb(230 228 220 / 0.75);
		transition: color 0.3s;
	}
	.label:is(:hover, :focus, [data-hot]) {
		z-index: 4;
	}
	.label:is(:hover, :focus, [data-hot]) .node {
		background: var(--color-acid);
		scale: 1.3;
	}
	.label:is(:hover, :focus, [data-hot]) .tag {
		color: var(--color-bone);
	}

	/* La fenêtre : un bloc carré à coins de visée, qui se déplie depuis le
	   repère vers le cœur de la fleur (le nom part, lui, vers l'extérieur) */
	.card {
		position: absolute;
		top: 50%;
		right: 100%;
		display: block;
		width: 19rem;
		padding: 1rem 1.1rem 1.15rem;
		translate: -0.9rem -50%;
		border: 1px solid rgb(230 228 220 / 0.18);
		background: color-mix(in oklab, var(--color-void) 92%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		clip-path: inset(50% 0 50% 100%);
		opacity: 0;
		pointer-events: none;
		transition:
			clip-path 0.55s var(--ease-portal),
			opacity 0.3s;
	}
	.label[data-side='left'] .card {
		right: auto;
		left: 100%;
		translate: 0.9rem -50%;
		clip-path: inset(50% 100% 50% 0);
	}
	.label:is(:hover, :focus, [data-hot]) .card {
		clip-path: inset(0 0 0 0);
		opacity: 1;
	}
	.card .tick {
		position: absolute;
		width: 7px;
		height: 7px;
		border-color: var(--color-acid);
	}
	@media (max-width: 639px) {
		/* Sur téléphone, le numéro seul : le nom est dans la fenêtre, au toucher */
		.tag-name {
			display: none;
		}
		.card {
			width: 15rem;
		}
	}

</style>
