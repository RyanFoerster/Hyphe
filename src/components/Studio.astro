---
// Après la galerie : le studio remonte par-dessus la fleur éteinte.
// Un manifeste ; ce que l'on fait pousser, accroché aux pétales d'une fleur
// vue d'en haut (la même que celle du hero) ; la méthode, en trois plantes
// qui poussent côte à côte : graine, pousse, fleur.
import { site } from '../data/site';

const steps = [
	{ name: 'Seed', text: 'We listen, dig and find the one idea worth growing.' },
	{ name: 'Grow', text: 'Design and code move together, in small living prototypes.' },
	{ name: 'Bloom', text: 'Launch, then tend: measure, prune and keep it alive.' },
];
---

<section class="studio relative z-10 overflow-hidden bg-void" aria-labelledby="studio-title">
	<!-- Le fil sort de la galerie et devient la lisière de la section -->
	<canvas
		class="pointer-events-none block h-28 w-full opacity-70"
		data-ascii
		data-ascii-kind="mycelium"
		data-ascii-seed="23"
		data-ascii-size="10"
		aria-hidden="true"
	></canvas>

	<div class="grid gap-8 px-4 pb-16 pt-16 sm:px-6 md:grid-cols-12 md:pb-20 md:pt-24">
		<p class="meta md:col-span-3" data-reveal><span class="kicker" data-scramble>[ 02 ] The studio</span></p>
		<div class="md:col-span-9">
			<h2 id="studio-title" class="sr-only">The studio</h2>
			<p class="text-[clamp(1.6rem,3.2vw,3rem)] leading-[1.12] tracking-[-0.01em] text-bone" data-reveal>
				Hyphae are the threads a fungus grows to find, connect and feed. We work the same way: patiently, below the surface,
				until something <mark class="hl">blooms</mark>.
			</p>
			<p class="meta mt-8 text-mineral" data-reveal style="--reveal-delay: 120ms">
				Independent studio — {site.city}, working worldwide
			</p>
		</div>
	</div>

	<!-- Ce que l'on fait pousser : un savoir-faire au bout de chaque pétale -->
	<div class="pb-24 md:pb-32">
		<p class="meta mb-4 text-center" data-reveal><span class="kicker" data-scramble>What we grow</span></p>
		<div class="corolla relative mx-auto" data-corolla>
			<div class="halo pointer-events-none absolute inset-0" aria-hidden="true"></div>
			<canvas class="absolute inset-0 size-full" data-specimen="corolla" aria-hidden="true"></canvas>
			<ul>
				{
					site.services.map((s, i) => (
						<li class="label" data-petal-label>
							<span class="meta block text-acid/80">{String(i + 1).padStart(2, '0')}</span>
							<span class="name">{s}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<!-- La méthode : trois plantes qui poussent à l'apparition -->
	<div class="px-4 pb-32 sm:px-6 md:pb-44">
		<p class="meta mb-6 text-center" data-reveal><span class="kicker" data-scramble>How it grows</span></p>
		<div class="relative mx-auto max-w-5xl">
			<canvas class="stages-canvas pointer-events-none absolute inset-x-0 top-0 w-full" data-specimen="stages" aria-hidden="true"></canvas>
			<ol class="relative grid gap-4 md:grid-cols-3 md:gap-8">
				{
					steps.map((s, i) => (
						<li class="stage flex flex-col items-center text-center" data-reveal style={`--reveal-delay: ${i * 180}ms`}>
							<span class="pot meta mb-3 text-mineral-dim" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<p class="titre text-[2.8rem]">{s.name}</p>
							<p class="mt-2 max-w-[17rem] text-[15px] leading-relaxed text-bone/70">{s.text}</p>
						</li>
					))
				}
			</ol>
		</div>
		<div class="mt-16 flex justify-center" data-reveal>
			<button type="button" data-open-about class="meta inline-flex items-center gap-3 rounded-full border border-bone/20 px-5 py-2.5 text-bone transition hover:border-acid hover:text-acid">
				<span>About the studio</span><span aria-hidden="true">→</span>
			</button>
		</div>
	</div>
</section>

<style>
	/* ---- La corolle des savoir-faire ---- */
	.corolla {
		width: min(1100px, 100vw);
		height: min(760px, 92vw);
	}
	.halo {
		background: radial-gradient(closest-side, rgb(154 180 240 / 0.08), rgb(200 245 60 / 0.03) 55%, transparent);
	}
	.label {
		position: absolute;
		left: 0;
		top: 0;
		width: max-content;
		max-width: 11rem;
		padding: 0.4rem 0.75rem;
		text-align: center;
		border: 1px solid rgb(230 228 220 / 0.14);
		border-radius: 999px;
		background: color-mix(in oklab, var(--color-void) 78%, transparent);
		backdrop-filter: blur(8px);
		opacity: 0;
		transition: border-color 0.4s;
		will-change: transform;
	}
	.label .name {
		font-size: 14px;
		color: var(--color-bone);
	}
	.label:hover {
		border-color: var(--color-acid);
	}
	@media (max-width: 639px) {
		.label {
			max-width: 7.5rem;
			padding: 0.3rem 0.5rem;
		}
		.label .name {
			font-size: 12px;
		}
	}

	/* ---- La méthode ---- */
	.stages-canvas {
		height: 380px;
	}
	.stage {
		padding-top: 360px;
	}
	@media (max-width: 767px) {
		/* Sur mobile, les plantes se partagent la largeur : textes en dessous */
		.stage {
			padding-top: 0;
		}
		ol:has(.stage) {
			padding-top: 360px;
		}
	}
</style>
