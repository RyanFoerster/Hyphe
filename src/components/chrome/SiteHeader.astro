---
import { navLinks } from '~/data/navigation';
import { isActive } from '~/lib/nav';
import { site } from '~/data/site';

const { pathname } = Astro.url;
---

<header
  class="pointer-events-none fixed inset-x-0 top-0 z-40 flex flex-col gap-2 px-5 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 sm:px-7 sm:py-5"
  style="background:linear-gradient(var(--scrim-a), transparent)"
>
  <a
    href="/"
    class="pointer-events-auto whitespace-nowrap font-display text-lg text-nat-100 no-underline hover:text-nat-100"
    style="font-variation-settings:'WONK' 1; font-weight:600"
  >
    {site.nom}
  </a>

  <nav
    aria-label="Navigation principale"
    class="pointer-events-auto flex flex-wrap gap-x-4 gap-y-1 sm:gap-x-7"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-2xs tracking-wider uppercase no-underline',
            isActive(pathname, link.match) ? 'text-nat-100' : 'text-nat-300',
          ]}
        >
          {/* Littéral en tête ; le poétique s'efface sur mobile, jamais l'inverse. */}
          <span class="stack inline-grid">
            <span class="fade-nat whitespace-nowrap">
              {link.lit}<span class="hidden sm:inline"> — {link.poetique}</span>
            </span>
            <span class="fade-tel whitespace-nowrap text-tele-cyan" aria-hidden="true">
              {link.lit}<span class="hidden sm:inline"> — {link.tel}</span>
            </span>
          </span>
        </a>
      ))
    }
  </nav>
</header>
