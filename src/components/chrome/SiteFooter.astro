---
import { site } from '~/data/site';

interface Props {
  /** `absolute` colle le pied au bas d'une section plein écran. */
  position?: 'flow' | 'absolute';
  class?: string;
}

const { position = 'flow', class: className = '' } = Astro.props;
---

<footer
  class:list={[
    'text-2xs tracking-wide text-nat-400',
    position === 'absolute' ? 'absolute inset-x-0 bottom-6 text-center' : 'mt-20 text-center',
    className,
  ]}
>
  <p class="mx-auto mb-2 max-w-[46em] text-nat-300">
    {site.nom}, création numérique à Liège. Design UX/UI et
    développement de sites web et d'applications sur mesure.
  </p>
  station d'observation, {site.station} ·{' '}
  <a href="/mentions-legales">mentions légales</a> ·{' '}
  <a href="/confidentialite">confidentialité</a>
</footer>
