---
import DualText from '~/components/ui/DualText.astro';
import { stades } from '~/data/navigation';
import type { Crumb } from '~/data/navigation';

/**
 * Rail de position, à gauche.
 * Sur la page d'accueil il suit les six stades de l'organisme (piloté par
 * `stage-rail.ts`) ; ailleurs il devient un fil d'Ariane statique.
 */
interface Props {
  variant: 'stades' | 'crumbs';
  crumbs?: Crumb[];
}

const { variant, crumbs = [] } = Astro.props;

const items =
  variant === 'stades'
    ? stades.map((s) => ({ href: `#${s.id}`, nat: s.nat, tel: s.tel }))
    : crumbs;
---

<nav
  aria-label="Position dans l'organisme"
  class="fixed left-6 top-1/2 z-40 hidden -translate-y-1/2 flex-col gap-3.5 min-[900px]:flex"
>
  {
    items.map((item, i) => {
      const actif = variant === 'crumbs' ? i === items.length - 1 : i === 0;
      return (
        <a
          href={item.href}
          data-rail-stage={variant === 'stades' ? i : undefined}
          class="flex items-center gap-2.5 no-underline transition-opacity duration-base ease-eco"
          style={`opacity:${actif ? 1 : variant === 'crumbs' ? 0.45 : 0.38}`}
        >
          <span
            data-rail-dot
            class="size-1.5 flex-none rounded-full"
            style={`background:${actif ? 'var(--color-spore)' : 'var(--color-nat-700)'}`}
          />
          <DualText
            nat={item.nat}
            tel={item.tel}
            class="text-2xs tracking-wider text-nat-200 max-[1499px]:hidden"
          />
        </a>
      );
    })
  }
</nav>
