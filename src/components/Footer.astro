---
import { site } from '../data/site';
---

<footer class="relative z-10 overflow-hidden border-t border-bone/8 bg-void" aria-labelledby="footer-title">
	<canvas
		class="pointer-events-none absolute inset-x-0 top-0 h-[70%] w-full opacity-70"
		data-ascii
		data-ascii-kind="roots"
		data-ascii-seed="14"
		data-ascii-size="11"
		aria-hidden="true"
	></canvas>

	<div class="relative grid gap-12 px-4 pb-8 pt-40 sm:px-6 md:grid-cols-12 md:pt-56">
		<div class="md:col-span-7" data-reveal>
			<p class="meta mb-6 text-mineral"><span data-scramble>[ Contact ]</span></p>
			<h2 id="footer-title" class="titre text-[clamp(3.2rem,8vw,9rem)]" data-split>Grow something with us.</h2>
			<a
				href={`mailto:${site.email}`}
				class="mt-10 inline-flex items-center gap-3 text-[clamp(1.25rem,2.2vw,1.9rem)] text-bone underline decoration-bone/25 decoration-1 underline-offset-[10px] transition hover:text-acid hover:decoration-acid"
			>
				{site.email} <span aria-hidden="true" class="text-[0.8em]">↗</span>
			</a>
		</div>

		<div class="grid grid-cols-2 gap-8 self-end md:col-span-4 md:col-start-9" data-reveal style="--reveal-delay: 150ms">
			<div>
				<p class="meta mb-3 text-mineral">Elsewhere</p>
				<ul class="space-y-1.5 text-sm">
					{site.socials.map((s) => (
						<li>
							<a href={s.href} target="_blank" rel="noopener" class="text-bone/80 transition hover:text-acid">{s.label} ↗</a>
						</li>
					))}
				</ul>
			</div>
			<div>
				<p class="meta mb-3 text-mineral">Studio</p>
				<p class="text-sm text-bone/80">{site.city}<br />Working worldwide</p>
				<button type="button" data-open-about class="meta mt-4 text-bone/70 transition hover:text-acid">Open about.sys</button>
			</div>
		</div>

		<div class="meta flex flex-wrap items-center justify-between gap-4 border-t border-bone/8 pt-5 text-mineral-dim md:col-span-12">
			<span>© {new Date().getFullYear()} {site.name}</span>
			<span class="hidden sm:inline">Hyphae floralis — grown in code, no seed</span>
			<a href="#main" class="transition hover:text-bone">Back to surface ↑</a>
		</div>
	</div>
</footer>
