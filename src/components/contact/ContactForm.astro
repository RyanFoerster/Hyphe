---
import Field from '~/components/ui/Field.astro';
import TextInput from '~/components/ui/TextInput.astro';
import SelectInput from '~/components/ui/SelectInput.astro';
import TextArea from '~/components/ui/TextArea.astro';
import Button from '~/components/ui/Button.astro';
import { missionOptions, budgetOptions } from '~/data/contact';
import { site } from '~/data/site';
---

<!-- Accusé de réception — révélé une fois le relevé transmis. -->
<div
  data-contact-sent
  hidden
  class="mt-12 flex w-full max-w-[560px] flex-col gap-3 rounded-plate border border-nat-800 bg-bg-1 px-9 py-10 text-center shadow-card"
>
  <div
    class="text-2xs tracking-wider uppercase"
    style="color:color-mix(in oklab, var(--color-nat-500) calc(100% - var(--mixp)), var(--color-tele-green))"
  >
    Relevé transmis
  </div>
  <p class="m-0 text-nat-300">
    Votre message est parti vers {site.email}. Réponse sous 24 h ouvrées.
  </p>
  <p class="m-0 text-2xs tracking-wide text-nat-400">
    Si votre client mail ne s'est pas ouvert, écrivez directement à {site.email}.
  </p>
</div>

<form
  data-contact-form
  data-email={site.email}
  novalidate
  class="mt-12 flex w-full max-w-[560px] flex-col gap-5.5 rounded-plate border border-nat-800 bg-bg-1 p-9 text-left shadow-card"
>
  <div class="flex items-baseline justify-between border-b-[3px] border-double border-nat-700 pb-3.5">
    <span class="text-2xs tracking-wider uppercase text-nat-300">Relevé de contact</span>
    <span class="text-2xs tracking-wide text-nat-400">TOUS CHAMPS REQUIS SAUF BUDGET</span>
  </div>

  <div class="grid gap-4.5 sm:grid-cols-2">
    <Field label="Nom" name="nom" hint="Comme sur le carnet">
      <TextInput name="nom" placeholder="[Prénom Nom]" required />
    </Field>
    <Field label="E-mail" name="email" hint="Pour la réponse">
      <TextInput name="email" type="email" placeholder="vous@station.be" required />
    </Field>
  </div>

  <div class="grid gap-4.5 sm:grid-cols-2">
    <Field label="Mission" name="mission">
      <SelectInput name="mission" options={missionOptions} value="design-dev" />
    </Field>
    <Field label="Budget" name="budget" hint="Fourchette indicative">
      <SelectInput name="budget" options={budgetOptions} value="nsp" />
    </Field>
  </div>

  <Field label="Message" name="message">
    <TextArea name="message" placeholder="Le terrain : votre projet, ce qui coince, l'échéance." />
  </Field>

  <div class="flex flex-wrap items-center justify-between gap-4">
    <Button type="submit">Enregistrer le relevé</Button>
    <span class="text-2xs tracking-wide text-nat-400">
      DONNÉES : RÉPONSE UNIQUEMENT — <a href="/confidentialite">CONFIDENTIALITÉ</a>
    </span>
  </div>

  <p data-form-error role="alert" hidden class="m-0 text-xs tracking-wide text-tele-coral"></p>
</form>
