---
// Les projets, vus de l'intérieur de la fleur. Chaque chapitre est un écran de
// défilement ; World place le spécimen correspondant dans la galerie et règle
// --focus selon la distance de la caméra.
import Window from './os/Window.astro';
import { coverOf, portraitOf, projects } from '../data/projects';

const years = projects.map((p) => p.year);
// La galerie n'en montre qu'une sélection ; l'herbier les garde tous
const selected = projects.slice(0, 4);
const pad = (n: number) => String(n).padStart(2, '0');
// Où flottent les noms de l'herbier : x, y (en % de l'écran) et profondeur
const FLOAT = [
	[14, 22, 1],
	[78, 18, 0.6],
	[86, 62, 0.9],
	[10, 70, 0.7],
	[48, 86, 0.5],
	[30, 10, 0.45],
	[66, 82, 0.8],
	[92, 38, 0.4],
];
// Sur mobile, pas de noms flottants : les projets pas encore vus sont en liste
const parts = (text: string, word: string) => {
	const i = text.indexOf(word);
	return i < 0 ? [text, '', ''] : [text.slice(0, i), word, text.slice(i + word.length)];
};
---

<section id="work" class="relative" aria-labelledby="work-title">
	<div class="dive relative h-[170svh]" data-dive>
		<div class="dive-title sticky top-0 z-[3] flex h-[100svh] flex-col items-center justify-center overflow-hidden px-4 text-center">
			<!-- Changement de section : un trait traverse l'écran, « 01 » s'allume -->
			<div class="seam meta pointer-events-none absolute inset-x-4 top-[15svh] flex items-center gap-4 sm:inset-x-6" aria-hidden="true">
				<span class="from text-mineral-dim">[ 00 ] Home</span>
				<span class="line h-px flex-1 bg-bone/25"></span>
				<span class="to text-acid">[ 01 ] Selected work</span>
			</div>
			<p class="meta relative text-mineral"><span class="kicker" data-scramble>[ 01 ] Selected work — {Math.min(...years)} / {Math.max(...years)}</span></p>
			<h2 id="work-title" class="specimen-title titre relative mt-7 text-[clamp(3.2rem,9vw,10rem)]" data-split>Come in, look around.</h2>
			<p class="meta relative mt-7 text-bone/60"><span data-scramble>{pad(selected.length)} projects, grown in here</span></p>
		</div>
	</div>

	<ol class="relative">
		{
			selected.map((p, i) => {
				const [before, word, after] = parts(p.summary, p.highlight);
				return (
					<li
						class="chapter relative h-[160svh]"
						id={p.slug}
						data-chapter
						data-slug={p.slug}
						data-accent={p.visual.accent}
						data-cover={coverOf(p)}
					>
						<div
							class:list={[
								'sticky top-0 z-[5] flex h-[100svh] items-end px-3 pb-4 sm:px-6 md:items-center md:px-[5vw] md:pb-0',
								i % 2 === 0 ? 'md:justify-end' : 'md:justify-start',
							]}
						>
							<article class="chapter-card w-full max-w-[25rem]" aria-labelledby={`chapter-${p.slug}`}>
								<Window title={`project.${pad(i + 1)}`} meta={`${p.year}`}>
									<img
										src={coverOf(p)}
										alt=""
										width="1600"
										height="900"
										loading="lazy"
										class="world-off-only aspect-video w-full object-cover"
									/>
									<div class="px-5 pb-5 pt-4">
										<p class="meta text-mineral">
											<span data-scramble>{pad(i + 1)} / {pad(selected.length)} — {p.category}</span>
										</p>
										<h3 id={`chapter-${p.slug}`} class="titre mt-4 text-[clamp(2.9rem,5vw,5rem)]" data-split>
											{p.name}
										</h3>
										<p class="meta mt-2 text-bone/60">{p.tagline} — {p.locality}</p>
										<ul class="mt-5 hidden grid-cols-3 gap-2 md:grid" aria-hidden="true">
											{[0, 1, 2].map((n) => (
												<li class="strip aspect-[4/5] overflow-hidden">
													<img src={portraitOf(p, n)} alt="" loading="lazy" class="size-full object-cover" />
												</li>
											))}
										</ul>
										<p class="mt-5 text-[15px] leading-relaxed text-bone/75">
											{before}
											{word && <mark class="hl">{word}</mark>}
											{after}
										</p>
										<dl class="meta mt-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-mineral">
											<dt class="text-mineral-dim">Client</dt>
											<dd class="text-bone/85">{p.client}</dd>
											<dt class="text-mineral-dim">Scope</dt>
											<dd>{p.services.slice(0, 3).join(' · ')}</dd>
										</dl>
										<a
											href={`/work/${p.slug}`}
											data-portal
											data-portal-target={`#frame-${p.slug}`}
											class="meta mt-6 inline-flex items-center gap-3 border border-bone/20 px-4 py-2.5 text-bone transition hover:border-acid hover:text-acid"
										>
											<span data-scramble>See the project</span>
											<span aria-hidden="true">→</span>
										</a>
									</div>
								</Window>
							</article>
						</div>
					</li>
				);
			})
		}
	</ol>

	<!-- Fin de la galerie : la fleur s'éteint, ses pétales se détachent et
	     flottent dans tout l'écran ; les noms de l'herbier dérivent avec eux -->
	<div class="exit relative h-[160svh]" data-exit>
		<div class="sticky top-0 z-[5] h-[100svh] overflow-hidden">
			<canvas class="drift absolute inset-0 size-full" data-specimen="drift" aria-hidden="true"></canvas>
			<ul class="floaters absolute inset-0" aria-label="All projects">
				{
					projects.map((p, i) => (
						<li
							class:list={['floater', FLOAT[i % FLOAT.length][0] > 50 && 'is-right', FLOAT[i % FLOAT.length][1] > 50 && 'is-low']}
							style={`--fx:${FLOAT[i % FLOAT.length][0]};--fy:${FLOAT[i % FLOAT.length][1]};--fz:${FLOAT[i % FLOAT.length][2]};--fd:${11 + ((i * 7) % 9)}s;--fp:${-i * 1.7}s;--t:${0.18 + i * 0.035}`}
						>
							<a href={`/work/${p.slug}`} data-portal class="group block">
								<!-- Au survol, la planche du projet se déplie vers le centre de l'écran -->
								<span class="peek" data-portal-frame aria-hidden="true">
									<img src={coverOf(p)} alt="" loading="lazy" width="1600" height="900" />
									<span class="tick left-0 top-0 border-l border-t" />
									<span class="tick right-0 top-0 border-r border-t" />
									<span class="tick bottom-0 left-0 border-b border-l" />
									<span class="tick bottom-0 right-0 border-b border-r" />
									<span class="peek-cap meta">fig. {pad(i + 1)} — {p.category}</span>
								</span>
								<span class="meta block text-mineral">
									<span class="text-acid">{pad(i + 1)}</span> — {p.year}
								</span>
								<span class="name titre block">{p.name}</span>
								<span class="place meta block text-bone/45">{p.tagline}</span>
							</a>
						</li>
					))
				}
			</ul>
			<div class="pointer-events-none relative flex h-full flex-col items-start justify-center px-4 text-left md:items-center md:text-center">
				<p class="ex-in meta" style="--t: 0.1"><span class="kicker">That was {pad(selected.length)} of {pad(projects.length)} projects</span></p>
				<a href="/work" data-portal class="all ex-in pointer-events-auto group mt-8 inline-flex items-baseline gap-[0.25em] max-md:items-end" style="--t: 0.2">
					<span class="titre text-[clamp(3.6rem,8vw,8.5rem)] max-md:leading-[0.92]" data-frame-word>View all <br class="md:hidden" />projects</span>
					<span class="arrow titre text-[clamp(2.2rem,5vw,5rem)] text-acid max-md:pb-[0.18em]" aria-hidden="true">→</span>
				</a>
				<!-- Mobile : les projets que la galerie n'a pas montrés, en liste -->
				<ol class="rest pointer-events-auto mt-10 w-full border-b border-dashed border-bone/15 md:hidden">
					{
						projects.slice(selected.length).map((p, i) => (
							<li class="ex-in" style={`--t: ${0.26 + i * 0.05}`}>
								<a href={`/work/${p.slug}`} data-portal class="flex items-baseline gap-4 border-t border-dashed border-bone/15 py-3">
									<span class="meta tabular-nums text-acid">{pad(selected.length + i + 1)}</span>
									<span class="titre min-w-0 flex-1 truncate pb-1 text-[1.9rem]">{p.name}</span>
									<span class="meta tabular-nums text-mineral">{p.year}</span>
								</a>
							</li>
						))
					}
				</ol>
				<p class="ex-in meta mt-6 text-bone/50" style="--t: 0.3">The rest is waiting, all on one page</p>
			</div>
		</div>
	</div>
</section>

<style>
	/* ---- Passage du hero à la galerie, piloté par la plongée ----
	   --tin  0 → 1  le titre se rassemble, du contour au plein
	   --num  0 → 1  le trait traverse, la section suivante s'annonce
	   --tout 0 → 1  on traverse le titre en entrant dans la fleur */
	.dive {
		--tin: 1;
		--tout: 0;
		--num: 1;
	}
	.dive-title {
		opacity: var(--t, 1);
	}
	.seam .line {
		transform-origin: 0 50%;
		scale: var(--num) 1;
	}
	.seam .from {
		opacity: calc(1 - var(--num) * 0.75);
	}
	.seam .to {
		opacity: var(--num);
		translate: calc((1 - var(--num)) * -1.5em) 0;
	}
	/* Les lettres arrivent écartées, en contour, et se resserrent en plein */
	.specimen-title {
		scale: calc(1 + var(--tout) * 0.9);
		filter: blur(calc(var(--tout) * 10px));
	}
	.specimen-title :global(.l) {
		translate: calc((1 - var(--tin)) * var(--o, 0) * 1.1em) calc((1 - var(--tin)) * var(--j, 0) * 0.03em);
	}
	.specimen-title :global(.g) {
		color: color-mix(in oklab, var(--color-bone) calc(var(--tin) * 100%), transparent);
		-webkit-text-stroke: 1px rgb(230 228 220 / calc(0.7 * (1 - var(--tin))));
	}
	/* Verre plus dense : le texte reste lisible sur la galerie en caractères */
	.chapter-card :global(.os-window) {
		background: color-mix(in oklab, var(--color-void) 88%, transparent);
	}
	.strip {
		border: 1px solid rgb(230 228 220 / 0.12);
	}
	.chapter-card {
		opacity: var(--focus, 1);
		translate: 0 calc((1 - var(--focus, 1)) * 26px);
		filter: blur(calc((1 - var(--focus, 1)) * 6px));
	}
	:global(html[data-world='on']) .world-off-only {
		display: none;
	}
	/* Sans le monde 3D, pas besoin d'un si long couloir */
	:global(html:not(.world)) .dive {
		height: 70svh;
	}
	/* Fin de galerie, pilotée par --x (0 → 1 au fil du bloc) */
	.exit {
		--x: 0;
	}
	.ex-in {
		opacity: clamp(0, (var(--x) - var(--t)) * 8, 1);
		translate: 0 calc(clamp(0, 1 - (var(--x) - var(--t)) * 8, 1) * 18px);
		filter: blur(calc(clamp(0, 1 - (var(--x) - var(--t)) * 8, 1) * 6px));
	}
	/* Le lien vers l'herbier : le mot est détecté au survol, la flèche avance */
	.all [data-frame-word] {
		position: relative;
		display: inline-block;
	}
	.all [data-frame-word]::after {
		content: '';
		position: absolute;
		inset: -0.04em -0.14em 0.02em;
		border: 1px solid var(--color-acid);
		clip-path: inset(0 100% 100% 0);
		transition: clip-path 0.5s var(--ease-organic);
	}
	.all:hover [data-frame-word]::after,
	.all:focus-visible [data-frame-word]::after {
		clip-path: inset(0 0 0 0);
	}
	.arrow {
		transition: translate 0.5s var(--ease-organic);
	}
	.all:hover .arrow,
	.all:focus-visible .arrow {
		translate: 0.3em 0;
	}
	/* Le fond flottant apparaît quand la fleur s'éteint. Il porte le même
	   terreau que le studio : sans lui, le monde fixe transparaît dessous et
	   la fin de galerie reste un ton plus claire que la section suivante. */
	.drift {
		background: var(--color-void);
		opacity: clamp(0, var(--x) * 3.5, 1);
	}
	/* Les noms de l'herbier : chacun dérive à sa profondeur, suit un peu le
	   curseur (--mx, --my), et arrive de loin au fil du bloc */
	.exit {
		--mx: 0;
		--my: 0;
	}
	.floater {
		position: absolute;
		left: calc(var(--fx) * 1%);
		top: calc(var(--fy) * 1%);
		translate: calc(-50% + var(--mx) * var(--fz) * -40px) calc(-50% + var(--my) * var(--fz) * -26px);
		scale: calc(0.55 + var(--fz) * 0.5);
		opacity: calc(clamp(0, (var(--x) - var(--t)) * 6, 1) * (0.45 + var(--fz) * 0.55));
		filter: blur(calc((1 - var(--fz)) * 1.6px + clamp(0, 1 - (var(--x) - var(--t)) * 6, 1) * 8px));
	}
	.floater > a {
		position: relative;
		animation: float var(--fd) ease-in-out var(--fp) infinite alternate;
		text-align: left;
	}
	/* On ne fait pas dériver ce qu'on est en train de lire */
	.floater > a:hover {
		animation-play-state: paused;
	}
	.floater .name {
		margin-block: 0.3rem 0.15rem;
		font-size: clamp(1.6rem, 2.6vw, 2.6rem);
		color: var(--color-bone);
		transition: color 0.3s;
	}
	.floater:hover,
	.floater:focus-within {
		opacity: 1;
		filter: none;
		z-index: 2;
	}
	/* Pendant qu'on en lit un, les autres reculent */
	.floaters:has(.floater:hover) .floater:not(:hover) {
		opacity: 0.18;
		filter: blur(3px);
	}
	.floaters:has(.floater:hover) ~ div {
		opacity: 0.15;
		filter: blur(4px);
	}
	.floaters ~ div {
		transition:
			opacity 0.5s,
			filter 0.5s;
	}
	/* La planche : posée à côté du nom, du côté du centre de l'écran */
	.peek {
		position: absolute;
		left: calc(100% + 1.4rem);
		top: 50%;
		width: clamp(14rem, 24vw, 22rem);
		aspect-ratio: 16 / 9;
		translate: 0 -50%;
		border: 1px solid rgb(230 228 220 / 0.16);
		clip-path: inset(50% 100% 50% 0);
		pointer-events: none;
		transition: clip-path 0.7s var(--ease-portal);
	}
	.is-right .peek {
		left: auto;
		right: calc(100% + 1.4rem);
		clip-path: inset(50% 0 50% 100%);
	}
	.is-low .peek {
		top: auto;
		bottom: 0;
		translate: 0 0;
	}
	.peek img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		scale: 1.12;
		transition: scale 1.2s var(--ease-organic);
	}
	.peek .tick {
		position: absolute;
		z-index: 1;
		width: 7px;
		height: 7px;
		border-color: var(--color-acid);
	}
	.peek-cap {
		position: absolute;
		left: 0.6rem;
		bottom: 0.55rem;
		z-index: 1;
		padding: 0.15rem 0.4rem;
		white-space: nowrap;
		color: var(--color-bone);
		background: color-mix(in oklab, var(--color-void) 80%, transparent);
	}
	.floater > a:hover .peek,
	.floater > a:focus-visible .peek {
		clip-path: inset(0 0 0 0);
	}
	.floater > a:hover .peek img,
	.floater > a:focus-visible .peek img {
		scale: 1;
	}
	.is-right > a {
		text-align: right;
	}
	.floater:hover .name {
		color: var(--color-acid);
	}
	@keyframes float {
		0% {
			transform: translate(-14px, 10px) rotate(-1.5deg);
		}
		100% {
			transform: translate(14px, -12px) rotate(1.5deg);
		}
	}
	/* Mobile : les noms flottants se bousculaient, ils laissent la place à la liste */
	@media (max-width: 767px) {
		.floaters {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.floater > a {
			animation: none;
		}
	}
	:global(html:not(.world)) .exit,
	:global(html:not(.world)) .exit > div {
		--x: 1;
		height: auto;
		position: relative;
		padding-block: 10svh;
	}
	@media (prefers-reduced-motion: reduce) {
		.exit {
			--x: 1;
		}
	}
	:global(html:not(.world)) .chapter {
		height: auto;
		padding-block: 10svh;
	}
	:global(html:not(.world)) .chapter > div {
		position: relative;
		height: auto;
	}
</style>

<script>
	// Progression du bloc de fin (--x de 0 à 1)
	const exit = document.querySelector<HTMLElement>('[data-exit]');
	if (exit && document.documentElement.classList.contains('world') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let shown = 0;
		let raf = 0;
		let mx = 0;
		let my = 0;
		let tx = 0;
		let ty = 0;
		const tick = () => {
			const r = exit.getBoundingClientRect();
			const x = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
			shown += (x - shown) * 0.16;
		mx += (tx - mx) * 0.08;
		my += (ty - my) * 0.08;
		exit.style.setProperty('--mx', mx.toFixed(3));
		exit.style.setProperty('--my', my.toFixed(3));
			if (Math.abs(x - shown) < 0.0005) shown = x;
			exit.style.setProperty('--x', shown.toFixed(4));
			raf = shown === x && Math.abs(tx - mx) < 0.002 && Math.abs(ty - my) < 0.002 ? 0 : requestAnimationFrame(tick);
		};
		const wake = () => raf || (raf = requestAnimationFrame(tick));
		addEventListener('scroll', wake, { passive: true });
		addEventListener('resize', wake);
		addEventListener(
			'pointermove',
			(e) => {
				tx = (e.clientX / innerWidth) * 2 - 1;
				ty = (e.clientY / innerHeight) * 2 - 1;
				if (exit.getBoundingClientRect().top < innerHeight) wake();
			},
			{ passive: true },
		);
		wake();
	}
</script>
