---
// Les projets, vus de l'intérieur de la fleur. Chaque chapitre est un écran de
// défilement ; World place le spécimen correspondant dans la galerie et règle
// --focus selon la distance de la caméra.
import Window from './os/Window.astro';
import { coverOf, portraitOf, projects } from '../data/projects';

const years = projects.map((p) => p.year);
const pad = (n: number) => String(n).padStart(2, '0');
const parts = (text: string, word: string) => {
	const i = text.indexOf(word);
	return i < 0 ? [text, '', ''] : [text.slice(0, i), word, text.slice(i + word.length)];
};
---

<section id="work" class="relative" aria-labelledby="work-title">
	<div class="dive relative h-[170svh]" data-dive>
		<div class="dive-title sticky top-0 z-[3] flex h-[100svh] flex-col items-center justify-center px-4 text-center">
			<p class="meta text-mineral"><span data-scramble>[ 01 ] Selected work — {Math.min(...years)} / {Math.max(...years)}</span></p>
			<h2 id="work-title" class="titre mt-7 text-[clamp(3.2rem,9vw,10rem)]" data-split>Enter the specimen</h2>
			<p class="meta mt-7 text-bone/60"><span data-scramble>{pad(projects.length)} projects grown inside</span></p>
		</div>
	</div>

	<ol class="relative">
		{
			projects.map((p, i) => {
				const [before, word, after] = parts(p.summary, p.highlight);
				return (
					<li
						class="chapter relative h-[160svh]"
						id={p.slug}
						data-chapter
						data-slug={p.slug}
						data-accent={p.visual.accent}
						data-cover={coverOf(p)}
					>
						<div
							class:list={[
								'sticky top-0 z-[5] flex h-[100svh] items-end px-3 pb-4 sm:px-6 md:items-center md:px-[5vw] md:pb-0',
								i % 2 === 0 ? 'md:justify-end' : 'md:justify-start',
							]}
						>
							<article class="chapter-card w-full max-w-[25rem]" aria-labelledby={`chapter-${p.slug}`}>
								<Window title={`specimen.${pad(i + 1)}`} meta={`${p.year}`}>
									<img
										src={coverOf(p)}
										alt=""
										width="1600"
										height="900"
										loading="lazy"
										class="world-off-only aspect-video w-full object-cover"
									/>
									<div class="px-5 pb-5 pt-4">
										<p class="meta text-mineral">
											<span data-scramble>{pad(i + 1)} / {pad(projects.length)} — {p.category}</span>
										</p>
										<h3 id={`chapter-${p.slug}`} class="titre mt-4 text-[clamp(2.9rem,5vw,5rem)]" data-split>
											{p.name}
										</h3>
										<p class="meta mt-2 text-bone/60">{p.latin} — {p.locality}</p>
										<ul class="mt-5 hidden grid-cols-3 gap-2 md:grid" aria-hidden="true">
											{[0, 1, 2].map((n) => (
												<li class="strip aspect-[4/5] overflow-hidden">
													<img src={portraitOf(p, n)} alt="" loading="lazy" class="size-full object-cover" />
												</li>
											))}
										</ul>
										<p class="mt-5 text-[15px] leading-relaxed text-bone/75">
											{before}
											{word && <mark class="hl">{word}</mark>}
											{after}
										</p>
										<dl class="meta mt-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-mineral">
											<dt class="text-mineral-dim">Client</dt>
											<dd class="text-bone/85">{p.client}</dd>
											<dt class="text-mineral-dim">Scope</dt>
											<dd>{p.services.slice(0, 3).join(' · ')}</dd>
										</dl>
										<a
											href={`/work/${p.slug}`}
											data-portal
											data-portal-target={`#frame-${p.slug}`}
											class="meta mt-6 inline-flex items-center gap-3 rounded-full border border-bone/20 px-4 py-2.5 text-bone transition hover:border-acid hover:text-acid"
										>
											<span data-scramble>Open the specimen</span>
											<span aria-hidden="true">→</span>
										</a>
									</div>
								</Window>
							</article>
						</div>
					</li>
				);
			})
		}
	</ol>

	<!-- Fin de la galerie : les caractères s'éteignent, les spécimens se rangent
	     dans l'herbier, reliés par un même fil. Puis le studio remonte par-dessus. -->
	<div class="exit relative h-[200svh]" data-exit>
		<div class="sticky top-0 z-[5] flex h-[100svh] items-center px-4 sm:px-6">
			<div class="mx-auto w-full max-w-5xl">
				<p class="meta flex items-baseline justify-between gap-4 text-mineral">
					<span class="ex-in" style="--t: 0.12">[ {pad(projects.length)} / {pad(projects.length)} ] Specimens collected</span>
					<span class="ex-in tabular-nums text-acid" style="--t: 0.12" data-exit-value>0.00000000</span>
				</p>
				<ol class="collected relative mt-6">
					<span class="thread" aria-hidden="true"></span>
					{
						projects.map((p, i) => (
							<li class="ex-row" style={`--t: ${(0.2 + i * 0.07).toFixed(2)}`}>
								<a href={`/work/${p.slug}`} data-portal class="crow group">
									<span class="node" aria-hidden="true" />
									<span class="meta tabular-nums text-mineral-dim">{String(i + 1).padStart(3, '0')}</span>
									<span class="cname titre text-[clamp(2.2rem,4.6vw,4.4rem)]" data-frame-word>{p.name}</span>
									<span class="meta hidden text-bone/60 md:block">{p.latin}</span>
									<span class="meta hidden text-mineral md:block">{p.locality}</span>
									<span class="meta tabular-nums text-mineral transition group-hover:text-acid">{p.year} →</span>
								</a>
							</li>
						))
					}
				</ol>
				<div class="ex-in mt-8 flex flex-wrap items-center justify-between gap-4" style="--t: 0.62">
					<p class="meta text-mineral-dim">End of the gallery — pressed and labelled</p>
					<a href="/work" class="meta inline-flex items-center gap-3 border border-bone/20 px-4 py-2.5 text-bone transition hover:border-acid hover:text-acid">
						<span>Open the herbarium</span><span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.dive-title {
		opacity: var(--t, 1);
	}
	/* Verre plus dense : le texte reste lisible sur la galerie en caractères */
	.chapter-card :global(.os-window) {
		background: color-mix(in oklab, var(--color-void) 88%, transparent);
	}
	.strip {
		border: 1px solid rgb(230 228 220 / 0.12);
	}
	.chapter-card {
		opacity: var(--focus, 1);
		translate: 0 calc((1 - var(--focus, 1)) * 26px);
		filter: blur(calc((1 - var(--focus, 1)) * 6px));
	}
	:global(html[data-world='on']) .world-off-only {
		display: none;
	}
	/* Sans le monde 3D, pas besoin d'un si long couloir */
	:global(html:not(.world)) .dive {
		height: 70svh;
	}
	/* Fin de galerie, pilotée par --x (0 → 1 au fil du bloc) */
	.exit {
		--x: 0;
	}
	.ex-in,
	.ex-row {
		opacity: clamp(0, (var(--x) - var(--t)) * 8, 1);
		translate: 0 calc(clamp(0, 1 - (var(--x) - var(--t)) * 8, 1) * 18px);
	}
	.ex-row {
		filter: blur(calc(clamp(0, 1 - (var(--x) - var(--t)) * 8, 1) * 6px));
	}
	.collected {
		border-top: 1px dashed rgb(230 228 220 / 0.15);
	}
	/* Le fil qui relie les spécimens, il pousse vers le bas */
	.thread {
		position: absolute;
		left: 3px;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--color-acid);
		transform-origin: top;
		scale: 1 clamp(0, (var(--x) - 0.18) * 2.4, 1);
		opacity: 0.6;
	}
	.crow {
		position: relative;
		display: grid;
		grid-template-columns: 2.25rem 3rem 1fr auto;
		align-items: baseline;
		gap: 1rem;
		padding: 1rem 0 0.75rem;
		border-bottom: 1px dashed rgb(230 228 220 / 0.15);
	}
	@media (min-width: 768px) {
		.crow {
			grid-template-columns: 2.25rem 3.5rem 1fr 12rem 9rem 5rem;
		}
	}
	.node {
		align-self: center;
		width: 7px;
		height: 7px;
		border: 1px solid var(--color-acid);
		background: var(--color-void);
		transition: background-color 0.3s;
	}
	.crow:hover .node,
	.crow:focus-visible .node {
		background: var(--color-acid);
	}
	.cname {
		position: relative;
		justify-self: start;
		transition: translate 0.5s var(--ease-organic);
	}
	.cname::after {
		content: '';
		position: absolute;
		inset: -0.04em -0.14em 0.02em;
		border: 1px solid var(--color-acid);
		clip-path: inset(0 100% 100% 0);
		transition: clip-path 0.45s var(--ease-organic);
	}
	.crow:hover .cname,
	.crow:focus-visible .cname {
		translate: 0.6rem 0;
	}
	.crow:hover .cname::after,
	.crow:focus-visible .cname::after {
		clip-path: inset(0 0 0 0);
	}
	:global(html:not(.world)) .exit,
	:global(html:not(.world)) .exit > div {
		--x: 1;
		height: auto;
		position: relative;
		padding-block: 10svh;
	}
	@media (prefers-reduced-motion: reduce) {
		.exit {
			--x: 1;
		}
	}
	:global(html:not(.world)) .chapter {
		height: auto;
		padding-block: 10svh;
	}
	:global(html:not(.world)) .chapter > div {
		position: relative;
		height: auto;
	}
</style>

<script>
	// Progression du bloc de fin, et sa valeur qui défile
	const exit = document.querySelector<HTMLElement>('[data-exit]');
	const value = exit?.querySelector<HTMLElement>('[data-exit-value]');
	if (exit && value && document.documentElement.classList.contains('world') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let shown = 0;
		let raf = 0;
		const tick = () => {
			const r = exit.getBoundingClientRect();
			const x = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
			shown += (x - shown) * 0.16;
			if (Math.abs(x - shown) < 0.0005) shown = x;
			exit.style.setProperty('--x', shown.toFixed(4));
			value.textContent = (shown + (shown > 0 && shown < 1 ? 0.00000001 : 0)).toFixed(8);
			raf = shown === x ? 0 : requestAnimationFrame(tick);
		};
		const wake = () => raf || (raf = requestAnimationFrame(tick));
		addEventListener('scroll', wake, { passive: true });
		addEventListener('resize', wake);
		wake();
	}
</script>
