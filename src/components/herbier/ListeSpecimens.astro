---
import type { EntreeArbre } from '~/lib/arbre';

/**
 * La vérité sémantique de l'herbier : une liste de liens (nom, type, client,
 * date) — c'est elle que lisent les lecteurs d'écran et les crawlers, et
 * c'est elle que parcourt le clavier ; le fruit correspondant s'active sur
 * l'arbre au focus. Rendue UNE seule fois, quel que soit le nombre de
 * projections visuelles (portrait, espalier).
 */
interface Props {
  entrees: EntreeArbre[];
}

const { entrees } = Astro.props;
---

<ul class="sr-only">
  {
    entrees.map((e) => (
      <li
        data-specimen
        data-techs={e.techs.join('|')}
        data-mission={e.mission}
        data-livrable={e.famille}
      >
        <a href={`/herbier/${e.slug}`} data-cible={e.slug}>
          {e.tag} — {e.nom}, pour {e.client} ({e.collecte})
        </a>
      </li>
    ))
  }
</ul>
