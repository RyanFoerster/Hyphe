---
/** Filtres de l'herbier — les mêmes pour les deux vues. */
interface Props {
  legend: string;
  group: 'tech' | 'mission' | 'livrable';
  /** Une chaîne sert à la fois de valeur et de libellé. */
  values: (string | { value: string; label: string })[];
}

const { legend, group, values } = Astro.props;
const options = values.map((v) => (typeof v === 'string' ? { value: v, label: v } : v));
---

<fieldset class="m-0 flex flex-wrap items-center gap-2.5 border-0 p-0">
  <legend class="float-left mr-2.5 text-2xs tracking-wider uppercase text-nat-400">{legend}</legend>
  {
    options.map((o) => (
      <button
        type="button"
        data-chip={group}
        data-value={o.value}
        data-active="false"
        aria-pressed="false"
        class="chip"
      >
        {o.label}
      </button>
    ))
  }
</fieldset>

<style>
  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    padding: 5px 10px;
    border-radius: var(--radius-input);
    cursor: pointer;
    background: transparent;
    color: var(--color-nat-300);
    border: 1px solid var(--color-nat-800);
    transition: all var(--duration-fast) var(--ease-eco);
  }
  .chip:hover {
    color: var(--color-nat-100);
    border-color: var(--color-nat-700);
  }
  .chip[data-active='true'] {
    background: var(--color-nat-800);
    color: var(--color-nat-100);
    border-color: var(--color-nat-600);
  }
</style>
