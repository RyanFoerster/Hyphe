---
import type { EntreeArbre } from '~/lib/arbre';
import { charpente, construireArbre } from '~/lib/arbre';

/**
 * L'arbre de collecte — la vue naturaliste de l'herbier.
 *
 * L'arbre SVG est la couche visuelle, aria-hidden ; la vérité pour les
 * lecteurs d'écran et les crawlers est la liste sémantique qui le précède
 * (le focus clavier y navigue, le fruit correspondant s'active).
 * La topologie vient de `lib/arbre.ts`, partagée avec la projection
 * télémétrie (étape 3).
 *
 * La croissance d'entrée parle le langage de la radicule du loader :
 * traits en dashoffset, `--ease-eco`, anciennes branches d'abord, fruits en
 * dernier — 1,5 s maximum, quel que soit le nombre de branches. Les états
 * vivants (`fane`, `est-actif`) sont pilotés par `scripts/herbier.ts` et
 * `scripts/arbre.ts`. Un clic sur un fruit est une navigation ordinaire :
 * le cartouche est un vrai `<a href>`, rien d'autre.
 */
interface Props {
  entrees: EntreeArbre[];
  id?: string;
  /** `portrait` (défaut) ou `espalier` — le port mobile. */
  mode?: 'portrait' | 'espalier';
  class?: string;
}

const { entrees, id = 'arbre', mode = 'portrait', class: className = '' } = Astro.props;
const arbre = construireArbre(entrees, { mode });
const squelette = charpente(arbre);
const hachures = `${id}-hachures`;
const hachuresFines = `${id}-hachures-fines`;

/* ── Cadence de croissance : bornée à ~1,5 s, peu importe la densité ── */
const nB = arbre.branches.length;
const staggerB = nB > 1 ? Math.min(110, Math.round(520 / (nB - 1))) : 0;
const delaiBranche = (i: number) => 260 + i * staggerB;
const delaiFruit = (i: number, k: number) => delaiBranche(i) + 150 + k * 45;

/* ── L'annotation replie le résumé à la main (le SVG ne sait pas) ── */
const replier = (texte: string, max = 38): string[] => {
  const lignes: string[] = [];
  let cur = '';
  for (const mot of texte.split(' ')) {
    if (`${cur} ${mot}`.trim().length > max) {
      lignes.push(cur.trim());
      cur = mot;
    } else cur = `${cur} ${mot}`;
  }
  if (cur.trim()) lignes.push(cur.trim());
  return lignes.slice(0, 3);
};

const legende = [
  { glyphe: 'anneau', texte: 'anneau de datation — la saison où la branche a quitté le tronc' },
  { glyphe: 'greffe', texte: 'ligature de greffe — projet mené à deux, design + développement' },
  { glyphe: 'bourgeon', texte: 'bourgeon — collecte en cours, prochain spécimen' },
];
---

<div class:list={['relative', className]} data-arbre-vue={mode}>
  {/* La charpente sérialisée — le redressement (scripts/charpente.ts) la lit. */}
  <script type="application/json" data-charpente-donnees set:html={JSON.stringify(squelette)} />

  <svg
    data-arbre
    viewBox={`0 0 ${arbre.largeur} ${arbre.hauteur}`}
    class="block h-auto w-full"
    aria-hidden="true"
  >
    <defs>
      <pattern id={hachures} patternUnits="userSpaceOnUse" width="7" height="7" patternTransform="rotate(-24)">
        <line x1="0" y1="0" x2="0" y2="7" stroke="currentColor" stroke-width="0.8" opacity="0.42" />
      </pattern>
      <pattern id={hachuresFines} patternUnits="userSpaceOnUse" width="5" height="5" patternTransform="rotate(32)">
        <line x1="0" y1="0" x2="0" y2="5" stroke="currentColor" stroke-width="0.5" opacity="0.3" />
      </pattern>

      {/* Le hover sporulant (scripts/sporulation.ts) — la planche respire :
          turbulence de plume en naturaliste, ondulation de scanline en
          télémétrie. Le scale est piloté au survol, un seul fruit à la fois. */}
      <filter id={`${id}-spor-nat`} data-sporule="nat" x="-15%" y="-15%" width="130%" height="130%">
        <feTurbulence type="fractalNoise" baseFrequency="0.012 0.017" numOctaves="2" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="0" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id={`${id}-spor-tel`} data-sporule="tel" x="-15%" y="-15%" width="130%" height="130%">
        <feTurbulence type="turbulence" baseFrequency="0.003 0.09" numOctaves="1" seed="3" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="0" xChannelSelector="R" yChannelSelector="B" />
      </filter>
    </defs>

    <g class="text-nat-100" fill="none" stroke="currentColor" color="var(--color-nat-100)">
      {/* Échelle de relevé, bord gauche — le curseur suit le scroll */}
      <g class="text-nat-300" color="var(--color-nat-300)" stroke-width="1">
        <line
          x1="44"
          y1={arbre.graduations[arbre.graduations.length - 1]?.y}
          x2="44"
          y2={arbre.graduations[0]?.y}
          opacity="0.6"
        />
        {
          arbre.graduations.map((g) => (
            <>
              <line x1="44" y1={g.y} x2={g.majeure ? 58 : 51} y2={g.y} opacity="0.7" />
              {g.majeure && (
                <text x="64" y={g.y + 3} fill="currentColor" stroke="none" class="font-mono" font-size="9" letter-spacing="0.08em">
                  {g.valeur}
                </text>
              )}
            </>
          ))
        }
        <text
          x="44"
          y={(arbre.graduations[arbre.graduations.length - 1]?.y ?? 0) - 14}
          fill="currentColor"
          stroke="none"
          class="font-mono"
          font-size="8.5"
          letter-spacing="0.14em"
        >
          ÉCHELLE — CM
        </text>
        <g data-echelle-curseur class="echelle-curseur" opacity="0">
          <path d="M30 0 L40 -4 L40 4 Z" fill="currentColor" stroke="none" />
        </g>
      </g>

      {/* Le sol, les racines, puis le tronc — la croissance part d'ici */}
      <g class="tronc" style={`transform-origin:${arbre.troncAxe[0]?.x}px ${arbre.troncAxe[0]?.y}px`}>
        <line
          x1={arbre.sol.x1}
          y1={arbre.sol.y}
          x2={arbre.sol.x2}
          y2={arbre.sol.y}
          stroke-width="1"
          stroke-dasharray="7 5 2 6"
          opacity="0.6"
        />
        {arbre.racines.map((r) => <path d={r} stroke-width="1.6" stroke-linecap="round" />)}
        <path d={arbre.troncPath} fill={`url(#${hachures})`} stroke="currentColor" stroke-width="1.4" />
      </g>

      {/* Les branches — anciennes d'abord, en cascade */}
      {
        arbre.branches.map((b, i) => (
          <g data-branche={b.id} class="branche" style={`--db:${delaiBranche(i)}ms`}>
            {b.segments.map((seg, si) => (
              <path
                class="trait-pousse"
                data-seg={si}
                d={seg.d}
                pathLength="100"
                stroke-width={seg.largeur}
                stroke-linecap="round"
                style={`--dt:${delaiBranche(i) + si * 110}ms`}
              />
            ))}
            {b.brindilles.map((d) => (
              <path
                class="trait-pousse"
                d={d}
                pathLength="100"
                stroke-width="0.9"
                stroke-linecap="round"
                opacity="0.85"
                style={`--dt:${delaiBranche(i) + 300}ms`}
              />
            ))}

            <g class="note-pousse" style={`--dn:${delaiBranche(i) + 200}ms`}>
              <circle cx={b.anneau.x} cy={b.anneau.y} r="6" stroke-width="1.1" />
              <circle cx={b.anneau.x} cy={b.anneau.y} r="2.6" stroke-width="0.9" />
              <text
                x={b.labelPos.x}
                y={b.labelPos.y}
                fill="var(--color-nat-300)"
                stroke="none"
                text-anchor={b.cote === 1 ? 'start' : 'end'}
                class="font-mono uppercase"
                font-size="10"
                letter-spacing="0.14em"
              >
                {b.label}
              </text>
            </g>

            {
              b.fruits.map((f, k) => {
                /* Même ratio que la planche d'en-tête de la fiche : 16/9 —
                   la continuité géométrique du zoom en dépend. */
                const imgH = Math.round(((f.w - 18) * 9) / 16);
                const lignes = replier(f.entree.resume);
                const noteH = 30 + (lignes.length + 1) * 14;
                return (
                  <g
                    data-fruit-groupe={f.entree.slug}
                    data-techs={f.entree.techs.join('|')}
                    data-mission={f.entree.mission}
                    data-livrable={f.entree.famille}
                    class="fruit"
                    style={`--df:${delaiFruit(i, k)}ms`}
                  >
                    <path class="trait-pousse pedoncule" d={f.pedoncule} pathLength="100" stroke-width="1.2" style={`--dt:${delaiFruit(i, k) - 90}ms`} />
                    <circle cx={f.attache.x} cy={f.attache.y} r="2.2" fill="currentColor" stroke="none" class="note-pousse" style={`--dn:${delaiFruit(i, k) - 90}ms`} />
                    {f.greffe && <path class="note-pousse" d={f.greffe} stroke-width="1.1" opacity="0.85" style={`--dn:${delaiFruit(i, k)}ms`} />}

                    <a href={`/herbier/${f.entree.slug}`} data-fruit={f.entree.slug} aria-hidden="true" tabindex="-1">
                      <g transform={`translate(${f.x} ${f.y}) rotate(${f.rotation.toFixed(1)} ${f.w / 2} 0)`}>
                        <g class="anneau-focus" aria-hidden="true">
                          <rect x="-4" y="-4" width={f.w + 8} height={f.h + 8} rx="4" fill="none" stroke-width="0.8" />
                          <rect x="-7.5" y="-7.5" width={f.w + 15} height={f.h + 15} rx="5" fill="none" stroke-width="0.8" />
                        </g>
                        <g class="fantomes" aria-hidden="true">
                          <rect class="fantome-a" width={f.w} height={f.h} rx="3" fill="none" stroke-width="0.8" />
                          <rect class="fantome-b" width={f.w} height={f.h} rx="3" fill="none" stroke-width="0.8" />
                        </g>
                        <g class="fruit-corps">
                          <rect width={f.w} height={f.h} rx="3" fill="var(--color-bg-1)" stroke="currentColor" stroke-width="1.2" />
                          <rect x="4" y="4" width={f.w - 8} height={f.h - 8} rx="1.5" stroke="currentColor" stroke-width="0.5" opacity="0.55" />
                          <text x={f.w - 10} y="16" text-anchor="end" fill="var(--color-nat-300)" stroke="none" class="font-mono" font-size="8.5" letter-spacing="0.1em">
                            Nº {f.entree.num}
                          </text>

                          {f.entree.imageHref ? (
                            <image
                              href={f.entree.imageHref}
                              x="9"
                              y="22"
                              width={f.w - 18}
                              height={imgH}
                              preserveAspectRatio="xMidYMid slice"
                              style="filter:var(--img-filter)"
                            />
                          ) : (
                            <rect x="9" y="22" width={f.w - 18} height={imgH} fill={`url(#${hachuresFines})`} stroke="currentColor" stroke-width="0.5" opacity="0.8" />
                          )}
                          <rect x="9" y="22" width={f.w - 18} height={imgH} fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.6" />

                          {/* Double étiquetage : le littéral d'abord, le latin ensuite. */}
                          <text
                            x={f.w / 2}
                            y={f.h - (f.compact ? 32 : 40)}
                            text-anchor="middle"
                            fill="currentColor"
                            stroke="none"
                            class="font-mono uppercase"
                            font-size={f.compact ? 8.5 : 9.5}
                            letter-spacing="0.12em"
                          >
                            {f.entree.tag}
                          </text>
                          <text
                            x={f.w / 2}
                            y={f.h - (f.compact ? 14 : 18)}
                            text-anchor="middle"
                            fill="var(--color-nat-200)"
                            stroke="none"
                            class="font-display italic"
                            style="font-variation-settings:'WONK' 1"
                            font-size={f.compact ? 11.5 : 13}
                          >
                            {f.entree.latin}
                          </text>
                        </g>
                      </g>
                    </a>

                    {/* L'annotation de relevé — survol et focus clavier */}
                    <g class="fruit-note">
                      <line
                        x1={f.note.sous ? f.x + f.w / 2 : f.note.versDroite ? f.x + f.w : f.x}
                        y1={f.note.sous ? f.y + f.h : f.y + Math.min(30, f.h / 3)}
                        x2={f.note.sous ? f.note.x + 124 : f.note.versDroite ? f.note.x : f.note.x + 248}
                        y2={f.note.sous ? f.note.y : f.note.y + 14}
                        stroke-width="0.7"
                        opacity="0.7"
                      />
                      <rect
                        x={f.note.x}
                        y={f.note.y}
                        width="248"
                        height={noteH}
                        fill="var(--color-bg-0)"
                        fill-opacity="0.95"
                        stroke="var(--color-nat-700)"
                        stroke-width="0.8"
                      />
                      <text
                        x={f.note.x + 12}
                        y={f.note.y + 19}
                        fill="var(--color-nat-300)"
                        stroke="none"
                        class="font-mono uppercase"
                        font-size="8.5"
                        letter-spacing="0.1em"
                      >
                        {f.entree.client} · {f.entree.collecte.replace(/^\[|\]$/g, '')}
                      </text>
                      {lignes.map((l, li) => (
                        <text
                          x={f.note.x + 12}
                          y={f.note.y + 37 + li * 14}
                          fill="var(--color-nat-200)"
                          stroke="none"
                          class="font-mono"
                          font-size="10"
                        >
                          {l}
                        </text>
                      ))}
                    </g>
                  </g>
                );
              })
            }
          </g>
        ))
      }

      {/* Les spores du survol — huit points d'encre, un seul foyer à la fois */}
      <g data-spores aria-hidden="true">
        {Array.from({ length: 8 }).map((_, i) => (
          <circle class="spore" r={1 + (i % 3) * 0.3} fill="currentColor" opacity="0" />
        ))}
        <text
          class="spore-donnee"
          font-size="6"
          fill="var(--color-tele-cyan)"
          opacity="0"
          style="font-family:var(--font-mono);letter-spacing:0.06em"
        />
      </g>

      {/* Le bourgeon — la collecte continue */}
      <g class="text-nat-300 note-pousse" color="var(--color-nat-300)" style={`--dn:${delaiBranche(nB)}ms`}>
        <path d={arbre.bourgeon.path} stroke-width="1.2" />
        <circle cx={arbre.bourgeon.pointe.x} cy={arbre.bourgeon.pointe.y} r="3.4" fill="currentColor" stroke="none" opacity="0.8" />
        <text
          x={arbre.bourgeon.label.x}
          y={arbre.bourgeon.label.y}
          fill="currentColor"
          stroke="none"
          class="font-display italic"
          style="font-variation-settings:'WONK' 1"
          font-size="12"
        >
          collecte en cours
        </text>
      </g>

      {/* L'étiquette gravée à la base du tronc */}
      <g class="note-pousse" style="--dn:200ms">
        <rect x={arbre.etiquette.x} y={arbre.etiquette.y} width={arbre.etiquette.w} height={arbre.etiquette.h} fill="var(--color-bg-1)" stroke="currentColor" stroke-width="1.2" />
        <rect x={arbre.etiquette.x + 5} y={arbre.etiquette.y + 5} width={arbre.etiquette.w - 10} height={arbre.etiquette.h - 10} stroke="currentColor" stroke-width="0.5" opacity="0.55" />
        <text
          x={arbre.etiquette.x + arbre.etiquette.w / 2}
          y={arbre.etiquette.y + 29}
          text-anchor="middle"
          fill="currentColor"
          stroke="none"
          class="font-mono uppercase"
          font-size="11"
          letter-spacing="0.14em"
        >
          studio Hyphe — collection de spécimens depuis {arbre.depuis}
        </text>
        <text
          data-arbre-etat
          x={arbre.etiquette.x + arbre.etiquette.w / 2}
          y={arbre.etiquette.y + 50}
          text-anchor="middle"
          fill="var(--color-nat-300)"
          stroke="none"
          class="font-mono"
          font-size="10"
          letter-spacing="0.08em"
        >
          sites web & applications — {entrees.length} spécimens
        </text>
      </g>
    </g>
  </svg>

  {/* Légende de planche — la voix carnet de terrain */}
  <aside
    aria-label="Légende de la planche"
    class="mt-6 flex flex-col gap-1.5 border-t border-nat-800 pt-4 text-2xs tracking-wide text-nat-300 lg:absolute lg:right-0 lg:top-2 lg:mt-0 lg:max-w-[240px] lg:border-t-0 lg:border-l lg:pl-4 lg:pt-0"
  >
    {
      legende.map((l) => (
        <p class="m-0 flex items-start gap-2">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" class="mt-0.5 flex-none text-nat-100" color="var(--color-nat-100)">
            {l.glyphe === 'anneau' && (
              <>
                <circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.1" />
                <circle cx="8" cy="8" r="2.2" fill="none" stroke="currentColor" stroke-width="0.9" />
              </>
            )}
            {l.glyphe === 'greffe' && (
              <path d="M2 6 L14 9 M2 10 L14 13" fill="none" stroke="currentColor" stroke-width="1.2" />
            )}
            {l.glyphe === 'bourgeon' && (
              <>
                <path d="M3 14 C6 10 8 7 11 4" fill="none" stroke="currentColor" stroke-width="1.1" />
                <circle cx="11.5" cy="3.5" r="2.4" fill="currentColor" />
              </>
            )}
          </svg>
          <span>{l.texte}</span>
        </p>
      ))
    }
  </aside>
</div>

<style>
  /* ── Croissance d'entrée — le vocabulaire de la radicule ─────────
     Les valeurs finales vivent dans le CSS de base ; les animations en
     fill-mode backwards ne posent que l'état initial. Ainsi les états
     vivants (fane, cueilli…) transitionnent sans se battre avec elles,
     et prefers-reduced-motion (durées ~0) montre l'arbre déjà poussé. */
  @keyframes troncPousse {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes traitPousse {
    from {
      stroke-dashoffset: 100;
    }
  }
  @keyframes fruitMurit {
    from {
      opacity: 0;
      translate: 0 -8px;
    }
  }
  @keyframes noteApparait {
    from {
      opacity: 0;
    }
  }
  .tronc {
    animation: troncPousse 480ms var(--ease-eco) backwards;
  }
  .trait-pousse {
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
    animation: traitPousse 420ms var(--ease-eco) var(--dt, 0ms) backwards;
  }
  .note-pousse {
    animation: noteApparait 300ms var(--ease-eco) var(--dn, 0ms) backwards;
  }
  .fruit-corps {
    animation: fruitMurit 340ms var(--ease-eco) var(--df, 0ms) backwards;
  }

  /* ── Focus clavier : double filet d'encre en naturaliste, halo cyan en
     télémétrie — jamais l'anneau système. Piloté par `est-actif` (le focus
     vit sur la liste sémantique). ── */
  .anneau-focus {
    opacity: 0;
    stroke: currentColor;
    transition: opacity 140ms var(--ease-eco);
  }
  .fruit.est-actif .anneau-focus {
    opacity: 1;
  }
  :global(html[data-regime='night']) .anneau-focus {
    stroke: var(--color-tele-cyan);
    filter: drop-shadow(0 0 5px rgb(77 240 208 / 0.45));
  }

  /* ── Le hover sporulant : contours fantômes et spores, pilotés en JS.
     Naturaliste : un seul trait d'encre décalé, l'impression mal calée.
     Télémétrie : aberration chromatique cyan/corail très discrète. ── */
  .fantome-a,
  .fantome-b {
    opacity: 0;
    stroke: currentColor;
  }
  :global(html[data-regime='night']) .fantome-a {
    stroke: var(--color-tele-cyan);
  }
  :global(html[data-regime='night']) .fantome-b {
    stroke: var(--color-tele-coral);
  }

  /* ── Survol / focus : le rameau s'épaissit, l'annotation se déplie ── */
  .pedoncule {
    transition:
      stroke-width var(--duration-fast) var(--ease-eco),
      stroke-dashoffset 240ms var(--ease-eco);
  }
  .fruit:has(a:hover) .pedoncule,
  .fruit.est-actif .pedoncule {
    stroke-width: 2.1;
  }
  .fruit-note {
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms var(--ease-eco) 40ms;
  }
  .fruit:has(a:hover) .fruit-note,
  .fruit.est-actif .fruit-note {
    opacity: 1;
  }

  /* ── Fanage : le rameau pâlit, le fruit s'affaisse — rien ne disparaît ── */
  .fruit,
  .branche {
    transition: opacity 320ms var(--ease-eco);
  }
  .fruit-corps {
    transition:
      translate 320ms var(--ease-eco),
      rotate 320ms var(--ease-eco),
      opacity 260ms var(--ease-eco);
  }
  .fruit.fane {
    opacity: 0.38;
  }
  .fruit.fane .fruit-corps {
    translate: 0 5px;
    rotate: 1.4deg;
  }
  .branche.branche-fanee > .trait-pousse,
  .branche.branche-fanee > .note-pousse {
    opacity: 0.5;
  }

  .echelle-curseur {
    transition: opacity 200ms var(--ease-eco);
  }
</style>
