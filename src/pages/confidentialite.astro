---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageLegale from '~/components/legal/PageLegale.astro';
import { pagesLegales } from '~/data/legal';

const page = pagesLegales.confidentialite;
---

<BaseLayout
  title={page.titre}
  description="Ce que studio Hyphe fait des données transmises par le formulaire de contact. Aucun cookie de suivi."
  ecoMode="legal"
  crumbs={[{ href: '#', nat: 'Confidentialité', tel: 'sys.legal' }]}
>
  <PageLegale page={page} />
</BaseLayout>
