---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found">
	<section class="relative grid min-h-[100svh] place-items-center overflow-hidden px-4">
		<canvas
			class="pointer-events-none absolute inset-0 size-full opacity-50"
			data-ascii
			data-ascii-kind="mycelium"
			data-ascii-seed="404"
			data-ascii-size="12"
			aria-hidden="true"
		></canvas>
		<div class="relative text-center">
			<p class="meta mb-6 text-mineral">Error 404 — wrong turn</p>
			<h1 class="titre text-[clamp(3.5rem,10vw,9rem)]" data-split>Nothing grows here.</h1>
			<a href="/" class="meta mt-10 inline-block border border-bone/20 px-5 py-3 transition hover:border-acid hover:text-acid">
				Back to the start
			</a>
		</div>
	</section>
</Layout>
