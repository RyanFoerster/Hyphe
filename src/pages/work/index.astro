---
// L'herbier : tous les projets du studio. Deux lectures :
//   sheets  une grille serrée de planches au même format (4:5), l'étiquette
//           d'herbier posée dans la photo, une ligne de méta dessous
//   index   une liste serrée, l'image suit le curseur
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import Figure from '../../components/Figure.astro';
import Herbarium from '../../components/Herbarium.astro';
import { coverOf, portraitOf, projects } from '../../data/projects';

const years = projects.map((p) => p.year);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout title="Herbarium" description="Every specimen grown by Studio Hyphe: websites, interfaces and interactive worlds.">
	<section class="relative z-[1] px-4 pb-16 pt-36 sm:px-6 md:pt-44" aria-labelledby="work-title">
		<div class="grid gap-8 md:grid-cols-12">
			<p class="meta text-mineral md:col-span-3" data-reveal>
				<span class="kicker" data-scramble>[ Index ] Herbarium</span><br />
				<span class="text-mineral-dim">{pad(projects.length)} specimens — {Math.min(...years)} / {Math.max(...years)}</span>
			</p>
			<div class="md:col-span-9">
				<h1 id="work-title" class="titre text-[clamp(4rem,13vw,13rem)]" data-split>Herbarium</h1>
				<p class="mt-8 max-w-xl text-[15px] leading-relaxed text-bone/75" data-reveal style="--reveal-delay: 200ms">
					Every project the studio has grown, pressed and labelled. Websites, interfaces and interactive worlds,
					<mark class="hl">collected</mark> like specimens.
				</p>
			</div>
		</div>

		<div class="meta mt-14 flex items-center justify-between border-y border-dashed border-bone/15 py-3 text-mineral" data-reveal>
			<span>Read as</span>
			<div class="flex gap-1" role="group" aria-label="Display">
				<button type="button" class="toggle" data-mode="sheets" aria-pressed="true">[ Sheets ]</button>
				<button type="button" class="toggle" data-mode="index" aria-pressed="false">[ Index ]</button>
			</div>
		</div>
	</section>

	<!-- Planches : une grille serrée, toutes au même format -->
	<section class="relative z-[1] px-4 pb-28 sm:px-6" aria-label="Specimens, sheets" data-herbarium-view="sheets">
		<ol class="grid gap-x-5 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-20 xl:grid-cols-4">
			{
				projects.map((p, i) => (
					<li data-reveal style={`--reveal-delay: ${(i % 4) * 100}ms`}>
						<a href={`/work/${p.slug}`} data-portal class="card group block" aria-label={`${p.name} — ${p.latin}, ${p.client}, ${p.year}`}>
							<Figure src={portraitOf(p)} alt="" fig={pad(i + 1)} caption={p.category.toLowerCase()} ratio="4/5">
								<!-- L'étiquette d'herbier est posée dans la planche, comme sur une vraie feuille -->
								<span class="label-shade" aria-hidden="true" />
								<Herbarium project={p} inset class="label-in" />
							</Figure>
							<div class="mt-2 flex items-baseline justify-between gap-4 border-t border-dashed border-bone/12 pt-3">
								<p class="name titre min-w-0 truncate pb-1 text-[clamp(2rem,2.3vw,2.7rem)]">{p.name}</p>
								<span class="meta shrink-0 tabular-nums text-mineral">
									<span class="open mr-2 text-acid">open →</span>
									{p.year}
								</span>
							</div>
						</a>
					</li>
				))
			}
			<!-- La planche suivante attend sa graine : elle mène au contact -->
			<li data-reveal style={`--reveal-delay: ${(projects.length % 4) * 100}ms`}>
				<a href="#footer-title" class="next group flex flex-col">
					<span class="seed relative flex aspect-[4/5] flex-col justify-between p-4">
						<span class="tick left-0 top-0 border-l border-t" aria-hidden="true"></span>
						<span class="tick right-0 top-0 border-r border-t" aria-hidden="true"></span>
						<span class="tick bottom-0 left-0 border-b border-l" aria-hidden="true"></span>
						<span class="tick bottom-0 right-0 border-b border-r" aria-hidden="true"></span>
						<span class="meta flex justify-between text-mineral">
							<span>Herbarium Hyphe</span><span class="tabular-nums">No. {String(projects.length + 1).padStart(3, '0')}</span>
						</span>
						<span class="dot mx-auto" aria-hidden="true"></span>
						<span class="meta text-center text-mineral">Not yet grown — <span class="text-bone/80">a seed, waiting</span></span>
					</span>
					<span class="meta mt-3 text-mineral"><span class="text-bone/85">fig. {pad(projects.length + 1)}</span> — your project</span>
					<span class="mt-2 flex items-baseline justify-between gap-4 border-t border-dashed border-bone/12 pt-3">
						<span class="name titre min-w-0 truncate pb-1 text-[clamp(2rem,2.3vw,2.7rem)]">Yours?</span>
						<span class="meta shrink-0 text-acid">grow it →</span>
					</span>
				</a>
			</li>
		</ol>
	</section>

	<!-- Index : la lecture serrée -->
	<section class="index relative z-[1] hidden px-4 pb-32 sm:px-6" aria-label="Specimens, index" data-herbarium-view="index">
		<ol class="border-t border-dashed border-bone/15">
			{
				projects.map((p, i) => (
					<li>
						<a href={`/work/${p.slug}`} data-portal class="row group" data-row data-preview={coverOf(p)} data-latin={`fig. ${pad(i + 1)} — ${p.latin}`}>
							<span class="meta tabular-nums text-mineral-dim">{String(i + 1).padStart(3, '0')}</span>
							<span class="name titre text-[clamp(2.4rem,5vw,4.6rem)]" data-frame-word>{p.name}</span>
							<span class="meta hidden text-bone/70 md:block">{p.latin}</span>
							<span class="meta hidden text-mineral md:block">{p.category}</span>
							<span class="meta tabular-nums text-mineral">{p.year}</span>
						</a>
					</li>
				))
			}
		</ol>
		<div class="preview pointer-events-none fixed left-0 top-0 z-[5] hidden w-[320px] md:block" data-preview-box aria-hidden="true">
			<div class="relative aspect-video overflow-hidden border border-bone/15">
				<img alt="" class="absolute inset-0 size-full object-cover" data-preview-img />
			</div>
			<span class="tick left-0 top-0 border-l border-t"></span>
			<span class="tick right-0 top-0 border-r border-t"></span>
			<span class="tick bottom-[1.6rem] left-0 border-b border-l"></span>
			<span class="tick bottom-[1.6rem] right-0 border-b border-r"></span>
			<p class="meta mt-2 inline-block bg-void/85 px-1 text-bone/80" data-preview-cap></p>
		</div>
	</section>

	<canvas class="pointer-events-none relative z-[1] block h-32 w-full opacity-60" data-ascii data-ascii-kind="roots" data-ascii-seed="31" data-ascii-size="10" aria-hidden="true"></canvas>

	<Footer />
</Layout>

<style>
	.toggle {
		padding: 0.25rem 0.5rem;
		color: rgb(230 228 220 / 0.55);
		transition: color 0.3s;
	}
	.toggle[aria-pressed='true'],
	.toggle:hover {
		color: var(--color-acid);
	}

	/* ---------- La grille ---------- */
	/* L'étiquette dans la planche : un dégradé discret pour qu'elle se lise */
	.label-shade {
		position: absolute;
		inset: 45% 0 0;
		background: linear-gradient(to top, rgb(9 12 10 / 0.7), transparent);
		pointer-events: none;
	}
	:global(.label-in) {
		position: absolute !important;
		left: 0.75rem;
		bottom: 0.75rem;
		z-index: 1;
		width: min(17rem, calc(100% - 1.5rem));
	}
	/* La planche vide : une graine qui pulse, le cadre se resserre au survol */
	.seed {
		border: 1px dashed rgb(230 228 220 / 0.18);
		transition: border-color 0.4s;
	}
	.seed .tick {
		position: absolute;
		width: 9px;
		height: 9px;
		border-color: var(--color-acid);
		transition:
			width 0.5s var(--ease-organic),
			height 0.5s var(--ease-organic);
	}
	.next:is(:hover, :focus-visible) .seed {
		border-color: rgb(200 245 60 / 0.4);
	}
	.next:is(:hover, :focus-visible) .seed .tick {
		width: 22px;
		height: 22px;
	}
	.dot {
		width: 8px;
		height: 8px;
		background: var(--color-acid);
		box-shadow: 0 0 0 6px rgb(200 245 60 / 0.12);
		animation: seed 2.4s ease-in-out infinite;
	}
	@keyframes seed {
		50% {
			box-shadow: 0 0 0 14px rgb(200 245 60 / 0.04);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.dot {
			animation: none;
		}
	}
	.card .name,
	.next .name {
		transition: translate 0.6s var(--ease-organic);
	}
	.card:is(:hover, :focus-visible) .name,
	.next:is(:hover, :focus-visible) .name {
		translate: 0.3rem 0;
	}
	/* « open → » se glisse devant l'année au survol */
	.open {
		display: inline-block;
		opacity: 0;
		translate: -0.4rem 0;
		transition:
			opacity 0.35s,
			translate 0.5s var(--ease-organic);
	}
	.card:is(:hover, :focus-visible) .open {
		opacity: 1;
		translate: 0 0;
	}

	/* ---------- L'index ---------- */
	.row {
		position: relative;
		display: grid;
		grid-template-columns: 3.5rem 1fr auto;
		align-items: baseline;
		gap: 1.5rem;
		padding: 1.4rem 0 1rem;
		border-bottom: 1px dashed rgb(230 228 220 / 0.15);
	}
	@media (min-width: 768px) {
		.row {
			grid-template-columns: 4rem 1fr 14rem 11rem 4rem;
		}
	}
	.row .name {
		position: relative;
		justify-self: start;
		transition: translate 0.5s var(--ease-organic);
	}
	/* Survol : le nom est détecté */
	.row .name::after {
		content: '';
		position: absolute;
		inset: -0.04em -0.14em 0.02em;
		border: 1px solid var(--color-acid);
		clip-path: inset(0 100% 100% 0);
		transition: clip-path 0.45s var(--ease-organic);
	}
	.row:hover .name,
	.row:focus-visible .name {
		translate: 0.6rem 0;
	}
	.row:hover .name::after,
	.row:focus-visible .name::after {
		clip-path: inset(0 0 0 0);
	}
	.preview {
		opacity: 0;
		transition: opacity 0.3s;
	}
	.preview[data-on] {
		opacity: 1;
	}
	.preview .tick {
		position: absolute;
		border-color: var(--color-acid);
		width: 7px;
		height: 7px;
		margin: -4px;
	}
</style>

<script>
	// Lecture : planches ou index, mémorisée pour ce navigateur
	const KEY = 'hyphe:herbarium';
	const views = document.querySelectorAll<HTMLElement>('[data-herbarium-view]');
	const toggles = document.querySelectorAll<HTMLButtonElement>('.toggle');
	const set = (mode: string) => {
		views.forEach((v) => v.classList.toggle('hidden', v.dataset.herbariumView !== mode));
		toggles.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.mode === mode)));
		document.documentElement.dataset.herbarium = mode;
		try {
			localStorage.setItem(KEY, mode);
		} catch {}
		// Les figures d'une vue qui apparaît doivent pouvoir se révéler
		dispatchEvent(new Event('resize'));
	};
	toggles.forEach((t) => t.addEventListener('click', () => set(t.dataset.mode!)));
	try {
		const saved = localStorage.getItem(KEY);
		if (saved === 'index') set('index');
	} catch {}

	// Index : l'image du spécimen suit le curseur, avec sa légende
	const box = document.querySelector<HTMLElement>('[data-preview-box]')!;
	const img = document.querySelector<HTMLImageElement>('[data-preview-img]')!;
	const cap = document.querySelector<HTMLElement>('[data-preview-cap]')!;
	const pos = { x: 0, y: 0, tx: 0, ty: 0 };
	let raf = 0;
	const follow = () => {
		pos.x += (pos.tx - pos.x) * 0.18;
		pos.y += (pos.ty - pos.y) * 0.18;
		box.style.transform = `translate(${pos.x + 24}px, ${pos.y - 100}px)`;
		raf = requestAnimationFrame(follow);
	};
	document.querySelectorAll<HTMLElement>('[data-row]').forEach((row) => {
		row.addEventListener('pointerenter', (e) => {
			img.src = row.dataset.preview!;
			cap.textContent = row.dataset.latin ?? '';
			pos.x = pos.tx = e.clientX;
			pos.y = pos.ty = e.clientY;
			box.setAttribute('data-on', '');
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(follow);
		});
		row.addEventListener('pointermove', (e) => {
			pos.tx = e.clientX;
			pos.ty = e.clientY;
		});
		row.addEventListener('pointerleave', () => {
			box.removeAttribute('data-on');
			cancelAnimationFrame(raf);
		});
	});
</script>
