---
// L'herbier : tous les projets du studio. Deux lectures :
//   sheets  des planches d'herbier : la fleur du projet (sa forme, sa teinte),
//           ses savoir-faire légendés au bout des pétales, une règle, l'image
//           pressée à côté et l'étiquette
//   index   une liste serrée, l'image suit le curseur
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import Figure from '../../components/Figure.astro';
import Herbarium from '../../components/Herbarium.astro';
import { coverOf, projects } from '../../data/projects';

const years = projects.map((p) => p.year);
const pad = (n: number) => String(n).padStart(2, '0');
const letters = 'abcdefgh';

// Un spécimen par projet : nombre de pétales, teinte du voile, port des pétales
const SPECIMENS = [
	{ petals: 6, veil: '9ab4f0', leaves: 2, shape: { len: 1.2, width: 0.9 } },
	{ petals: 5, veil: 'f0b98a', leaves: 1, shape: { len: 1.05, width: 1.05, tip: -0.2, ruffle: 0.14 } },
	{ petals: 9, veil: '9fe0c8', leaves: 2, shape: { len: 1.1, width: 0.45, tip: -0.7, twist: 0.6 } },
	{ petals: 7, veil: 'c8a6f0', leaves: 2, shape: { len: 1.3, width: 0.75, base: 0.85, tip: -0.9, cup: 0.32 } },
	{ petals: 6, veil: 'd8dccf', leaves: 1, shape: { len: 1.0, width: 0.8, base: 0.35, tip: 0.1, ruffle: 0.04 } },
	{ petals: 8, veil: '8fd4e8', leaves: 2, shape: { len: 1.15, width: 0.6, ruffle: 0.18, twist: 0.8 } },
	{ petals: 5, veil: 'e8b8c8', leaves: 1, shape: { len: 1.3, width: 1.1, tip: -0.55, cup: 0.3 } },
];

/** La fleur d'un projet, au trait et vue d'en haut : ses pétales, sa largeur */
const glyph = (i: number) => {
	const sp = SPECIMENS[i % SPECIMENS.length];
	const n = sp.petals;
	const R = 12.5;
	const c = 14;
	const spread = Math.min(0.85, (sp.shape.width ?? 0.9) * 0.75);
	const pt = (a: number, r: number) => `${(c + Math.cos(a) * r).toFixed(1)} ${(c + Math.sin(a) * r).toFixed(1)}`;
	let d = '';
	for (let k = 0; k < n; k++) {
		const a = (k / n) * Math.PI * 2 - Math.PI / 2 + i * 0.4;
		const w = (Math.PI / n) * spread * 1.6;
		d += `M${c} ${c}Q${pt(a - w, R * 0.75)} ${pt(a, R)}Q${pt(a + w, R * 0.75)} ${c} ${c}`;
	}
	return d;
};
---

<Layout title="Herbarium" description="Every specimen grown by Studio Hyphe: websites, interfaces and interactive worlds.">
	<section class="relative z-[1] px-4 pb-16 pt-36 sm:px-6 md:pt-44" aria-labelledby="work-title">
		<div class="grid gap-8 md:grid-cols-12">
			<p class="meta text-mineral md:col-span-3" data-reveal>
				<span class="kicker" data-scramble>[ Index ] Herbarium</span><br />
				<span class="text-mineral-dim">{pad(projects.length)} specimens — {Math.min(...years)} / {Math.max(...years)}</span>
			</p>
			<div class="md:col-span-9">
				<h1 id="work-title" class="titre text-[clamp(4rem,13vw,13rem)]" data-split>Herbarium</h1>
				<p class="mt-8 max-w-xl text-[15px] leading-relaxed text-bone/75" data-reveal style="--reveal-delay: 200ms">
					Every project the studio has grown, pressed and labelled. Websites, interfaces and interactive worlds,
					<mark class="hl">collected</mark> like specimens.
				</p>
			</div>
		</div>

		<div class="meta mt-14 flex items-center justify-between border-y border-dashed border-bone/15 py-3 text-mineral" data-reveal>
			<span>Read as</span>
			<div class="flex gap-1" role="group" aria-label="Display">
				<button type="button" class="toggle" data-mode="sheets" aria-pressed="true">[ Sheets ]</button>
				<button type="button" class="toggle" data-mode="index" aria-pressed="false">[ Index ]</button>
			</div>
		</div>
	</section>

	<!-- Planches : une feuille d'herbier par projet -->
	<section class="relative z-[1] px-4 pb-24 sm:px-6" aria-label="Specimens, sheets" data-herbarium-view="sheets">
		<ol class="flex flex-col gap-10 md:gap-16">
			{
				projects.map((p, i) => {
					const sp = SPECIMENS[i % SPECIMENS.length];
					const no = String(i + 1).padStart(3, '0');
					return (
						<li data-reveal>
							<a
								href={`/work/${p.slug}`}
								data-portal
								data-plate
								class:list={['plate group', i % 2 === 1 && 'is-flip']}
								aria-label={`${p.name} — ${p.latin}, ${p.client}, ${p.year}`}
							>
								<span class="tick left-0 top-0 border-l border-t" aria-hidden="true" />
								<span class="tick right-0 top-0 border-r border-t" aria-hidden="true" />
								<span class="tick bottom-0 left-0 border-b border-l" aria-hidden="true" />
								<span class="tick bottom-0 right-0 border-b border-r" aria-hidden="true" />

								<p class="meta flex items-center justify-between gap-4 border-b border-dashed border-bone/12 pb-3 text-mineral" aria-hidden="true">
									<span>
										<span class="text-acid">Sheet {pad(i + 1)}</span> / {pad(projects.length)}
									</span>
									<span class="hidden md:inline">Herbarium Hyphe — {p.locality}</span>
									<span class="tabular-nums">No. {no}</span>
								</p>

								<div class="body">
									<!-- Le spécimen : la fleur du projet, sa règle, ses légendes -->
									<div class="specimen" aria-hidden="true">
										<canvas
											class="absolute inset-0 size-full"
											data-specimen="sheet"
											data-variant={i}
											data-petals={sp.petals}
											data-veil={sp.veil}
											data-leaves={sp.leaves}
											data-shape={JSON.stringify(sp.shape)}
										/>
										<span class="ruler">
											<span style="bottom: 0%">0</span>
											<span style="bottom: 50%">50</span>
											<span style="bottom: 100%">100 mm</span>
										</span>
										<ul class="petals">
											{p.services.map((s, k) => (
												<li class="petal" data-petal-label>
													<span class="node" />
													<span class="meta tag">
														<span class="text-acid">{letters[k]}</span> — {s}
													</span>
												</li>
											))}
										</ul>
										<p class="caption meta text-mineral">
											fig. {pad(i + 1)} — <span class="italic text-bone/70">{p.latin}</span>, {sp.petals} petals
										</p>
									</div>

									<!-- La fiche : le nom, l'image pressée, l'étiquette -->
									<div class="info">
										<p class="meta text-mineral">
											<span class="kicker">{p.category}</span>
											<span class="ml-2 tabular-nums">{p.year}</span>
										</p>
										<h2 class="name titre mt-5 text-[clamp(3.4rem,6.4vw,6.8rem)]">{p.name}</h2>
										<p class="mt-5 max-w-md text-[15px] leading-relaxed text-bone/70">{p.summary}</p>
										<Figure src={coverOf(p)} alt="" fig={`${pad(i + 1)}b`} caption="pressed sample" ratio="16/9" class="mt-8" />
										<Herbarium project={p} compact class="mt-6" />
										<span class="meta mt-6 inline-flex items-center gap-2 text-bone/60 transition group-hover:text-acid">
											Open the sheet <span class="arrow">→</span>
										</span>
									</div>
								</div>
							</a>
						</li>
					);
				})
			}
		</ol>
	</section>

	<!-- Index : la lecture serrée -->
	<section class="index relative z-[1] hidden px-4 pb-32 sm:px-6" aria-label="Specimens, index" data-herbarium-view="index">
		<ol class="border-t border-dashed border-bone/15">
			{
				projects.map((p, i) => (
					<li>
						<a
							href={`/work/${p.slug}`}
							data-portal
							class="row group"
							data-row
							data-index={i}
							data-preview={coverOf(p)}
							data-latin={`fig. ${pad(i + 1)} — ${p.latin}`}
							data-petals={SPECIMENS[i % SPECIMENS.length].petals}
							data-services={p.services.join('|')}
						>
							<span class="meta flex items-center gap-3 tabular-nums text-mineral-dim">
								<svg class="glyph" viewBox="0 0 28 28" width="28" height="28" aria-hidden="true" style={`--veil: #${SPECIMENS[i % SPECIMENS.length].veil}`}>
									<path d={glyph(i)} />
									<rect x="12.5" y="12.5" width="3" height="3" />
								</svg>
								{String(i + 1).padStart(3, '0')}
							</span>
							<span class="name titre text-[clamp(2.4rem,5vw,4.6rem)]" data-frame-word>{p.name}</span>
							<span class="meta hidden text-bone/70 md:block">{p.latin}</span>
							<span class="meta hidden text-mineral md:block">{p.category}</span>
							<span class="meta tabular-nums text-mineral">{p.year}</span>
						</a>
					</li>
				))
			}
		</ol>
		<!-- La loupe : le spécimen de la ligne survolée y éclot, posé sur son image pressée -->
		<div class="loupe pointer-events-none fixed left-0 top-0 z-[5] w-[300px]" data-preview-box aria-hidden="true">
			<div class="lens relative aspect-square overflow-hidden border border-bone/15 bg-void">
				<img alt="" class="sample absolute inset-0 size-full object-cover" data-preview-img />
				<canvas class="absolute inset-0 size-full" data-specimen="loupe" data-specimens={JSON.stringify(SPECIMENS)} data-show=""></canvas>
				<span class="tick left-0 top-0 border-l border-t"></span>
				<span class="tick right-0 top-0 border-r border-t"></span>
				<span class="tick bottom-0 left-0 border-b border-l"></span>
				<span class="tick bottom-0 right-0 border-b border-r"></span>
				<span class="meta absolute left-2.5 top-2 text-mineral" data-preview-petals></span>
			</div>
			<div class="mt-2 bg-void/85 px-2 py-1.5">
				<p class="meta text-bone/85" data-preview-cap></p>
				<ul class="meta mt-1 text-mineral" data-preview-services></ul>
			</div>
		</div>
	</section>

	<canvas class="pointer-events-none relative z-[1] block h-32 w-full opacity-60" data-ascii data-ascii-kind="roots" data-ascii-seed="31" data-ascii-size="10" aria-hidden="true"></canvas>

	<Footer />
</Layout>

<style>
	.toggle {
		padding: 0.25rem 0.5rem;
		color: rgb(230 228 220 / 0.55);
		transition: color 0.3s;
	}
	.toggle[aria-pressed='true'],
	.toggle:hover {
		color: var(--color-acid);
	}

	/* ---------- La planche : un cadre de visée, une feuille d'herbier ---------- */
	.plate {
		position: relative;
		display: block;
		padding: 1rem;
		border: 1px solid rgb(230 228 220 / 0.08);
		transition: border-color 0.5s var(--ease-organic);
	}
	@media (min-width: 768px) {
		.plate {
			padding: 1.25rem 1.5rem 1.5rem;
		}
	}
	.plate:hover,
	.plate:focus-visible {
		border-color: rgb(230 228 220 / 0.16);
	}
	.tick {
		position: absolute;
		width: 9px;
		height: 9px;
		border-color: var(--color-acid);
		transition:
			width 0.5s var(--ease-organic),
			height 0.5s var(--ease-organic);
	}
	.plate:is(:hover, :focus-visible) > .tick {
		width: 22px;
		height: 22px;
	}
	.body {
		display: grid;
		gap: 2rem;
		padding-top: 1.25rem;
	}
	@media (min-width: 900px) {
		.body {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			gap: 3rem;
			align-items: center;
		}
		.is-flip .body {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		}
		.is-flip .specimen {
			order: 2;
		}
	}

	/* Le spécimen : la toile, la règle d'herbier, les légendes des pétales */
	.specimen {
		position: relative;
		aspect-ratio: 1 / 1;
		max-height: 82svh;
		width: 100%;
		overflow: hidden;
	}
	.ruler {
		position: absolute;
		left: 0;
		top: 8%;
		bottom: 12%;
		width: 3rem;
		border-left: 1px solid rgb(230 228 220 / 0.2);
		background:
			repeating-linear-gradient(to top, rgb(230 228 220 / 0.32) 0 1px, transparent 1px 10%) left / 10px 100% no-repeat,
			repeating-linear-gradient(to top, rgb(230 228 220 / 0.16) 0 1px, transparent 1px 2%) left / 5px 100% no-repeat;
	}
	.is-flip .ruler {
		left: auto;
		right: 0;
		border-left: 0;
		border-right: 1px solid rgb(230 228 220 / 0.2);
		background-position: right, right;
	}
	.ruler > span {
		position: absolute;
		left: 14px;
		translate: 0 50%;
		font: 9px/1 var(--font-mono);
		letter-spacing: 0.04em;
		color: rgb(230 228 220 / 0.38);
		white-space: nowrap;
	}
	.is-flip .ruler > span {
		left: auto;
		right: 14px;
	}
	.petals {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.petal {
		position: absolute;
		left: 0;
		top: 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		opacity: 0;
		white-space: nowrap;
		will-change: transform;
	}
	.petal[data-side='left'] {
		flex-direction: row-reverse;
	}
	.node {
		width: 8px;
		height: 8px;
		flex: none;
		border: 1px solid var(--color-acid);
		background: rgb(200 245 60 / 0.25);
	}
	.tag {
		padding: 0.15rem 0.4rem;
		color: rgb(230 228 220 / 0.85);
		background: color-mix(in oklab, var(--color-void) 72%, transparent);
	}
	.caption {
		position: absolute;
		left: 3.75rem;
		bottom: 0.25rem;
	}
	.is-flip .caption {
		left: auto;
		right: 3.75rem;
		text-align: right;
	}

	/* La fiche */
	.info {
		position: relative;
	}
	.name {
		transition: translate 0.6s var(--ease-organic);
	}
	.plate:is(:hover, :focus-visible) .name {
		translate: 0.4rem 0;
	}
	.arrow {
		transition: translate 0.5s var(--ease-organic);
	}
	.plate:is(:hover, :focus-visible) .arrow {
		translate: 0.3em 0;
	}

	/* ---------- L'index ---------- */
	.row {
		position: relative;
		display: grid;
		grid-template-columns: 5.5rem 1fr auto;
		align-items: baseline;
		gap: 1.5rem;
		padding: 1.4rem 0 1rem;
		border-bottom: 1px dashed rgb(230 228 220 / 0.15);
	}
	@media (min-width: 768px) {
		.row {
			grid-template-columns: 6.5rem 1fr 14rem 11rem 4rem;
		}
	}
	/* La fleur de la ligne, au trait : elle tourne et s'allume au survol */
	.glyph {
		flex: none;
		align-self: center;
		overflow: visible;
		transition: rotate 0.9s var(--ease-organic);
	}
	.glyph path {
		stroke: var(--veil);
		stroke-width: 0.9;
		stroke-opacity: 0.45;
		transition:
			stroke-opacity 0.4s,
			fill-opacity 0.4s;
		fill: var(--veil);
		fill-opacity: 0;
	}
	.glyph rect {
		fill: var(--color-acid);
		opacity: 0.5;
		transition: opacity 0.4s;
	}
	.row:is(:hover, :focus-visible) .glyph {
		rotate: 72deg;
	}
	.row:is(:hover, :focus-visible) .glyph path {
		stroke-opacity: 1;
		fill-opacity: 0.12;
	}
	.row:is(:hover, :focus-visible) .glyph rect {
		opacity: 1;
	}
	.row .name {
		position: relative;
		justify-self: start;
		transition: translate 0.5s var(--ease-organic);
	}
	/* Survol : le nom est détecté */
	.row .name::after {
		content: '';
		position: absolute;
		inset: -0.04em -0.14em 0.02em;
		border: 1px solid var(--color-acid);
		clip-path: inset(0 100% 100% 0);
		transition: clip-path 0.45s var(--ease-organic);
	}
	.row:hover .name,
	.row:focus-visible .name {
		translate: 0.6rem 0;
	}
	.row:hover .name::after,
	.row:focus-visible .name::after {
		clip-path: inset(0 0 0 0);
	}
	.loupe {
		display: none;
		opacity: 0;
		scale: 0.96;
		transition:
			opacity 0.3s,
			scale 0.4s var(--ease-organic);
	}
	.loupe[data-live] {
		display: block;
	}
	.loupe[data-on] {
		opacity: 1;
		scale: 1;
	}
	/* L'image du projet, pressée sous le spécimen */
	.sample {
		opacity: 0.2;
		filter: grayscale(0.6) contrast(1.1);
	}
	.loupe .tick {
		width: 9px;
		height: 9px;
	}
</style>

<script>
	// Lecture : planches ou index, mémorisée pour ce navigateur
	const KEY = 'hyphe:herbarium';
	const views = document.querySelectorAll<HTMLElement>('[data-herbarium-view]');
	const toggles = document.querySelectorAll<HTMLButtonElement>('.toggle');
	const set = (mode: string) => {
		views.forEach((v) => v.classList.toggle('hidden', v.dataset.herbariumView !== mode));
		toggles.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.mode === mode)));
		document.documentElement.dataset.herbarium = mode;
		try {
			localStorage.setItem(KEY, mode);
		} catch {}
		// Les figures d'une vue qui apparaît doivent pouvoir se révéler
		dispatchEvent(new Event('resize'));
	};
	toggles.forEach((t) => t.addEventListener('click', () => set(t.dataset.mode!)));
	try {
		const saved = localStorage.getItem(KEY);
		if (saved === 'index') set('index');
	} catch {}

	// Index : la loupe suit le curseur ; le spécimen de la ligne y éclot, sur
	// son image pressée, avec ses savoir-faire
	const box = document.querySelector<HTMLElement>('[data-preview-box]')!;
	const img = document.querySelector<HTMLImageElement>('[data-preview-img]')!;
	const cap = document.querySelector<HTMLElement>('[data-preview-cap]')!;
	const petals = document.querySelector<HTMLElement>('[data-preview-petals]')!;
	const services = document.querySelector<HTMLElement>('[data-preview-services]')!;
	const lens = box.querySelector<HTMLCanvasElement>('[data-specimen="loupe"]')!;
	const letters = 'abcdefgh';
	const fine = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 768px)');
	const pos = { x: 0, y: 0, tx: 0, ty: 0 };
	let raf = 0;
	let rest = 0;
	let mounted = false;
	const follow = () => {
		pos.x += (pos.tx - pos.x) * 0.18;
		pos.y += (pos.ty - pos.y) * 0.18;
		// La loupe reste dans l'écran : elle passe à gauche du curseur près du bord
		const w = box.offsetWidth;
		const h = box.offsetHeight;
		const x = pos.x + 28 + w > innerWidth - 12 ? pos.x - 28 - w : pos.x + 28;
		const y = Math.min(innerHeight - h - 12, Math.max(12, pos.y - h * 0.45));
		box.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
		raf = requestAnimationFrame(follow);
	};
	document.querySelectorAll<HTMLElement>('[data-row]').forEach((row) => {
		row.addEventListener('pointerenter', (e) => {
			if (!fine.matches) return;
			// three.js n'arrive qu'au premier survol
			if (!mounted) {
				mounted = true;
				import('../../scripts/specimen').then((m) => m.mountSpecimens());
			}
			clearTimeout(rest);
			img.src = row.dataset.preview!;
			cap.textContent = row.dataset.latin ?? '';
			petals.textContent = `${row.dataset.petals} petals`;
			services.replaceChildren(
				...(row.dataset.services ?? '').split('|').map((s, k) => {
					const li = document.createElement('li');
					li.innerHTML = `<span class="text-acid">${letters[k]}</span> — `;
					li.append(s);
					return li;
				}),
			);
			lens.dataset.show = row.dataset.index;
			if (!box.hasAttribute('data-live')) {
				pos.x = pos.tx = e.clientX;
				pos.y = pos.ty = e.clientY;
			}
			box.setAttribute('data-live', '');
			requestAnimationFrame(() => box.setAttribute('data-on', ''));
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(follow);
		});
		row.addEventListener('pointermove', (e) => {
			pos.tx = e.clientX;
			pos.ty = e.clientY;
		});
		row.addEventListener('pointerleave', () => {
			box.removeAttribute('data-on');
			// La loupe se range (et sa toile s'arrête) si l'on ne survole plus rien
			rest = window.setTimeout(() => {
				box.removeAttribute('data-live');
				lens.dataset.show = '';
				cancelAnimationFrame(raf);
			}, 320);
		});
	});
</script>
