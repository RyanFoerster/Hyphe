---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import Figure from '../../components/Figure.astro';
import Herbarium from '../../components/Herbarium.astro';
import { projects, type Project } from '../../data/projects';

export const getStaticPaths = (() =>
	projects.map((project, i) => ({
		params: { slug: project.slug },
		props: { project, next: projects[(i + 1) % projects.length], index: i },
	}))) satisfies GetStaticPaths;

interface Props {
	project: Project;
	next: Project;
	index: number;
}

const { project: p, next } = Astro.props;
const visual = `/visuals/${p.slug}.svg`;
const v = (n: number) => `/visuals/${p.slug}/${n}.svg`;
const organism = { topo: 'mycelium', strata: 'roots', bloom: 'flower' }[p.visual.kind];
const accent = p.visual.accent === '#f07a2a' ? 'ember' : 'acid';
const domain = `${p.name.toLowerCase().replace(/\s+/g, '')}.com`;
// Le mot mis en exergue dans l'introduction, s'il y figure
const word = [p.highlight, p.client].find((w) => p.intro.includes(w)) ?? '';
const at = word ? p.intro.indexOf(word) : -1;
const intro = at < 0 ? [p.intro, '', ''] : [p.intro.slice(0, at), word, p.intro.slice(at + word.length)];
const palette = [
	{ name: 'Ground', hex: p.visual.bg },
	{ name: 'Line', hex: p.visual.line },
	{ name: 'Accent', hex: p.visual.accent },
	{ name: 'Bone', hex: '#e6e4dc' },
];
---

<Layout title={p.name} description={p.summary} image={visual}>
	<!-- L'environnement du projet : on y entre par la mosaïque -->
	<section class="relative h-[100svh] min-h-[600px] overflow-hidden" aria-labelledby="project-title">
		<img src={visual} alt="" class="absolute inset-0 size-full scale-105 object-cover" fetchpriority="high" />
		<div class="absolute inset-0 bg-gradient-to-b from-void/30 via-transparent to-void"></div>
		<canvas
			class="pointer-events-none absolute inset-y-[12%] right-0 w-full opacity-80 md:w-1/2"
			data-ascii
			data-ascii-kind={organism}
			data-ascii-seed={p.visual.seed}
			data-ascii-size="11"
			data-ascii-accent={accent}
			aria-hidden="true"
		></canvas>

		<div class="relative flex h-full flex-col justify-end gap-8 px-4 pb-6 pt-24 sm:px-6 md:flex-row md:items-end md:justify-between md:pb-8">
			<div>
				<p class="meta mb-6 text-mineral">
					<a href="/work" class="transition hover:text-bone">Herbarium</a>
					<span class="text-mineral-dim"> / </span><span class="text-bone/80" data-scramble>{p.slug}.prj</span>
				</p>
				<h1 id="project-title" class="titre text-[clamp(4rem,13vw,13rem)]" data-split style="--split-delay: 700ms">{p.name}</h1>
				<p class="meta mt-5 max-w-xl text-bone/70">{p.latin} — {p.summary}</p>
			</div>
			<Herbarium project={p} class="w-full shrink-0 md:w-[340px]" />
		</div>
	</section>

	<!-- Introduction -->
	<section class="grid gap-8 px-4 py-28 sm:px-6 md:grid-cols-12 md:py-40">
		<p class="meta text-mineral md:col-span-3" data-reveal><span data-scramble>[ 01 ] Introduction</span></p>
		<p class="text-[clamp(1.5rem,2.9vw,2.75rem)] leading-[1.15] tracking-[-0.01em] text-bone md:col-span-9" data-reveal>
			{intro[0]}{intro[1] && <mark class="hl">{intro[1]}</mark>}{intro[2]}
		</p>
	</section>

	<!-- Planche I : le visuel clé, le site -->
	<section class="space-y-24 px-4 sm:px-6 md:space-y-32" aria-label="Gallery, plate I">
		<Figure src={v(1)} alt={`${p.name}, key visual`} fig="01" caption="key visual" ratio="21/9" />

		<figure class="mx-auto max-w-[1400px]" data-reveal>
			<div class="browser">
				<div class="meta flex h-8 items-center gap-3 border-b border-dashed border-bone/15 px-3 text-mineral">
					<span class="text-acid">*</span>
					<span class="text-bone/80">https://{domain}</span>
					<span class="ml-auto hidden sm:inline">1440 × 900 — live</span>
				</div>
				<div class="relative aspect-[16/9] overflow-hidden">
					<img src={visual} alt={`${p.name} website, home page`} loading="lazy" class="absolute inset-0 size-full object-cover" />
					<div class="absolute inset-0 bg-gradient-to-r from-void/80 via-void/20 to-transparent"></div>
					<div class="absolute inset-x-[4%] top-[5%] flex items-center justify-between">
						<span class="text-[clamp(0.6rem,1.1vw,0.95rem)] tracking-wide text-bone/90">{p.name}</span>
						<span class="meta hidden gap-6 text-bone/60 sm:flex"><span>Index</span><span>About</span><span>Shop</span></span>
					</div>
					<div class="absolute bottom-[10%] left-[4%] max-w-[55%]">
						<p class="titre text-[clamp(1.6rem,6vw,6rem)]">{p.name}</p>
						<p class="mt-[3%] max-w-[80%] text-[clamp(0.55rem,1.05vw,0.95rem)] leading-snug text-bone/70">{p.summary}</p>
					</div>
				</div>
			</div>
			<figcaption class="meta mt-3 text-mineral"><span class="text-bone/85">fig. 02</span> — website, home</figcaption>
		</figure>
	</section>

	<canvas class="pointer-events-none mt-24 block h-28 w-full opacity-60" data-ascii data-ascii-kind="mycelium" data-ascii-seed={p.visual.seed + 3} data-ascii-size="10" aria-hidden="true"></canvas>

	<!-- Défi et approche -->
	<section class="grid gap-x-6 gap-y-16 px-4 py-24 sm:px-6 md:grid-cols-12 md:py-32">
		<div class="md:col-span-4" data-reveal>
			<p class="meta mb-5 text-mineral"><span data-scramble>[ 02 ] Challenge</span></p>
			<p class="text-lg leading-relaxed text-bone/85">{p.challenge}</p>
		</div>
		<div class="md:col-span-7 md:col-start-6" data-reveal style="--reveal-delay: 120ms">
			<p class="meta mb-5 text-mineral"><span data-scramble>[ 03 ] Approach</span></p>
			<ol class="space-y-8">
				{
					p.approach.map((step, i) => (
						<li class="grid grid-cols-[2.5rem_1fr] gap-4 border-t border-dashed border-bone/15 pt-6">
							<span class="meta text-acid/80">{String(i + 1).padStart(2, '0')}</span>
							<p class="text-lg leading-relaxed text-bone/85">{step}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- Planche II : détails, écrans, matière -->
	<section class="space-y-24 px-4 sm:px-6 md:space-y-36" aria-label="Gallery, plate II">
		<div class="grid gap-14 md:grid-cols-12 md:gap-6">
			<Figure class="md:col-span-5" src={v(3)} alt={`${p.name}, detail`} fig="03" caption="detail, line work" ratio="4/5" />
			<Figure class="md:col-span-6 md:col-start-7 md:mt-48" src={v(2)} alt={`${p.name}, secondary visual`} fig="04" caption="system, second family" ratio="16/11" />
		</div>

		<div class="grid grid-cols-3 gap-3 md:grid-cols-12 md:gap-6">
			{
				[4, 5, 6].map((n, i) => (
					<div class:list={['md:col-span-3', i === 0 && 'md:col-start-2', i === 1 && 'md:mt-24', i === 2 && 'md:mt-48']}>
						<Figure src={v(n)} alt={`${p.name} on mobile, screen ${i + 1}`} fig={String(5 + i).padStart(2, '0')} caption={['mobile, home', 'mobile, story', 'mobile, detail'][i]} ratio="9/19" />
					</div>
				))
			}
		</div>

		<!-- Planche de matière : typographie et couleurs -->
		<figure class="grid gap-6 md:grid-cols-12" data-reveal>
			<div class="plate relative flex min-h-[420px] flex-col justify-between overflow-hidden p-6 md:col-span-7" style={`background:${p.visual.bg}`}>
				<p class="meta flex justify-between text-bone/60"><span>Type specimen</span><span>Parceh / Instrument Sans</span></p>
				<p class="titre text-[clamp(7rem,18vw,16rem)] text-bone">Aa</p>
				<p class="titre text-[clamp(2rem,4vw,3.6rem)]" style={`color:${p.visual.accent}`}>{p.name}</p>
			</div>
			<ul class="grid grid-cols-2 gap-3 md:col-span-5">
				{
					palette.map((c) => (
						<li class="swatch flex aspect-square flex-col justify-end p-3" style={`background:${c.hex}`}>
							<span class="meta text-bone mix-blend-difference">{c.name}</span>
							<span class="meta tabular-nums text-bone/70 mix-blend-difference">{c.hex.toUpperCase()}</span>
						</li>
					))
				}
			</ul>
			<figcaption class="meta text-mineral md:col-span-12"><span class="text-bone/85">fig. 08</span> — matter: type and colour</figcaption>
		</figure>

		<Figure src={v(5)} alt={`${p.name}, motion still`} fig="09" caption="motion still, frame 0284" ratio="21/9">
			<p class="meta absolute bottom-4 left-4 flex gap-4 text-bone/80">
				<span class="text-acid">▸</span><span class="tabular-nums">00:12:04</span><span class="text-mineral">[####::::::::]</span>
			</p>
		</Figure>
	</section>

	<canvas class="pointer-events-none mt-24 block h-28 w-full opacity-60" data-ascii data-ascii-kind="roots" data-ascii-seed={p.visual.seed + 9} data-ascii-size="10" aria-hidden="true"></canvas>

	<!-- Services et résultats -->
	<section class="grid gap-x-6 gap-y-16 px-4 py-24 sm:px-6 md:grid-cols-12 md:py-32">
		<div class="md:col-span-4" data-reveal>
			<p class="meta mb-5 text-mineral"><span data-scramble>[ 04 ] Services</span></p>
			<ul class="meta flex flex-wrap gap-x-3 gap-y-2 text-bone/85">
				{p.services.map((s) => <li><span class="text-mineral-dim">[</span> {s} <span class="text-mineral-dim">]</span></li>)}
			</ul>
		</div>
		{
			p.results && (
				<div class="md:col-span-7 md:col-start-6" data-reveal style="--reveal-delay: 120ms">
					<p class="meta mb-5 text-mineral"><span data-scramble>[ 05 ] Results</span></p>
					<dl class="grid gap-6 sm:grid-cols-3">
						{p.results.map((r) => (
							<div class="flex flex-col border-t border-dashed border-bone/15 pt-5">
								<dt class="meta order-2 mt-2 text-mineral">{r.label}</dt>
								<dd class="text-[clamp(2.4rem,4vw,3.6rem)] leading-none tracking-[-0.03em] text-bone">{r.value}</dd>
							</div>
						))}
					</dl>
				</div>
			)
		}
	</section>

	<!-- Spécimen suivant -->
	<section class="px-4 sm:px-6" aria-label="Next project">
		<a href={`/work/${next.slug}`} data-portal class="group block" data-reveal>
			<p class="meta mb-4 flex justify-between text-mineral">
				<span>Next specimen — {next.latin}</span><span>{next.client} — {next.year}</span>
			</p>
			<div data-portal-frame class="next relative h-[42vh] min-h-[260px] overflow-hidden">
				<img src={`/visuals/${next.slug}.svg`} alt="" loading="lazy" class="absolute inset-0 size-full object-cover transition duration-[1400ms] ease-(--ease-organic) group-hover:scale-105" />
				<div class="absolute inset-0 bg-gradient-to-t from-void/80 to-transparent"></div>
				<p class="titre absolute bottom-5 left-5 text-[clamp(3rem,9vw,9rem)] transition-transform duration-700 ease-(--ease-organic) group-hover:translate-x-3" data-split>{next.name}</p>
			</div>
		</a>
	</section>

	<Footer />
</Layout>

<style>
	.browser,
	.plate,
	.next {
		border: 1px solid rgb(230 228 220 / 0.12);
		background-color: var(--color-deep);
	}
	.swatch {
		border: 1px solid rgb(230 228 220 / 0.12);
	}
</style>
