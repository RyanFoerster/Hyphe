---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import Figure from '../../components/Figure.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import NextSpecimen from '../../components/NextSpecimen.astro';
import { coverOf, platesOf, projects, type Plate, type Project } from '../../data/projects';

export const getStaticPaths = (() =>
	projects.map((project, i) => ({
		params: { slug: project.slug },
		props: { project, next: projects[(i + 1) % projects.length], index: i },
	}))) satisfies GetStaticPaths;

interface Props {
	project: Project;
	next: Project;
	index: number;
}

const { project: p, next } = Astro.props;
const visual = coverOf(p);
const domain = p.url ?? `${p.name.toLowerCase().replace(/\s+/g, '')}.com`;
// Le mot mis en exergue dans l'introduction, s'il y figure
const word = [p.highlight, p.client].find((w) => p.intro.includes(w)) ?? '';
const at = word ? p.intro.indexOf(word) : -1;
const intro = at < 0 ? [p.intro, '', ''] : [p.intro.slice(0, at), word, p.intro.slice(at + word.length)];
// Mise en planches : une image 16:9 par rangée (pleine largeur ou décalée), les
// 4:5 qui se suivent groupées par deux ou trois, en quinconce
type Row = { wide: Plate; n: number } | { tall: Plate[]; n: number };
const rows: Row[] = [];
platesOf(p).forEach((plate, i) => {
	const last = rows[rows.length - 1];
	if (plate.ratio === '4/5' && last && 'tall' in last && last.tall.length < 3) last.tall.push(plate);
	else rows.push(plate.ratio === '4/5' ? { tall: [plate], n: i + 1 } : { wide: plate, n: i + 1 });
});
const plateI = rows.slice(0, 2);
const plateII = rows.slice(2);
const fig = (n: number) => String(n).padStart(2, '0');
const wideClass = (k: number) => (k % 2 === 0 ? 'md:col-span-12' : k % 4 === 1 ? 'md:col-span-9 md:col-start-4' : 'md:col-span-9');
const tallClass = (count: number, j: number) =>
	count === 1
		? j === 0 ? 'md:col-span-5 md:col-start-2' : ''
		: count === 2
			? ['md:col-span-5 md:col-start-2', 'md:col-span-5 md:col-start-8 md:mt-40'][j]
			: ['md:col-span-3 md:col-start-2', 'md:col-span-3 md:col-start-6 md:mt-24', 'md:col-span-3 md:col-start-10 md:mt-48'][j];
const palette = [
	{ name: 'Ground', hex: p.visual.bg },
	{ name: 'Line', hex: p.visual.line },
	{ name: 'Accent', hex: p.visual.accent },
	{ name: 'Bone', hex: '#e6e4dc' },
];
---

<Layout title={p.name} description={p.summary} image={visual}>
	<!-- L'environnement du projet (le même rendu clôt la page précédente) -->
	<section aria-labelledby="project-title">
		<ProjectHero project={p} />
	</section>

	<!-- Introduction -->
	<section class="grid gap-8 px-4 py-28 sm:px-6 md:grid-cols-12 md:py-40">
		<p class="meta text-mineral md:col-span-3" data-reveal><span data-scramble>[ 01 ] Introduction</span></p>
		<p class="text-[clamp(1.5rem,2.9vw,2.75rem)] leading-[1.15] tracking-[-0.01em] text-bone md:col-span-9" data-reveal>
			{intro[0]}{intro[1] && <mark class="hl">{intro[1]}</mark>}{intro[2]}
		</p>
	</section>

	<!-- Plate I -->
	<section class="space-y-24 px-4 sm:px-6 md:space-y-36" aria-label="Gallery, plate i">
		{
			plateI.map((row, k) =>
				'wide' in row ? (
					<div class="grid md:grid-cols-12">
						<Figure
							class={wideClass(k)}
							src={row.wide.src}
							alt={`${p.name}, ${row.wide.caption}`}
							fig={fig(row.n)}
							caption={row.wide.caption}
							ratio="16/9"
							video={row.wide.kind === 'video'}
							poster={row.wide.poster}
							browser={row.wide.kind === 'browser' ? domain : undefined}
						/>
					</div>
				) : (
					<div class="grid grid-cols-2 gap-3 md:grid-cols-12 md:gap-6">
						{row.tall.map((plate, j) => (
							<Figure
								class:list={[tallClass(row.tall.length, j), row.tall.length === 3 && j === 2 && 'col-span-2 mx-auto w-1/2 md:w-auto']}
								src={plate.src}
								alt={`${p.name}, ${plate.caption}`}
								fig={fig(row.n + j)}
								caption={plate.caption}
								ratio="4/5"
							/>
						))}
					</div>
				),
			)
		}
	</section>

	<canvas class="pointer-events-none mt-24 block h-28 w-full opacity-60" data-ascii data-ascii-kind="mycelium" data-ascii-seed={p.visual.seed + 3} data-ascii-size="10" aria-hidden="true"></canvas>

	<!-- Défi et approche -->
	<section class="grid gap-x-6 gap-y-16 px-4 py-24 sm:px-6 md:grid-cols-12 md:py-32">
		<div class="md:col-span-4" data-reveal>
			<p class="meta mb-5 text-mineral"><span data-scramble>[ 02 ] Challenge</span></p>
			<p class="text-lg leading-relaxed text-bone/85">{p.challenge}</p>
		</div>
		<div class="md:col-span-7 md:col-start-6" data-reveal style="--reveal-delay: 120ms">
			<p class="meta mb-5 text-mineral"><span data-scramble>[ 03 ] Approach</span></p>
			<ol class="space-y-8">
				{
					p.approach.map((step, i) => (
						<li class="grid grid-cols-[2.5rem_1fr] gap-4 border-t border-dashed border-bone/15 pt-6">
							<span class="meta text-acid/80">{String(i + 1).padStart(2, '0')}</span>
							<p class="text-lg leading-relaxed text-bone/85">{step}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- Plate II -->
	<section class="space-y-24 px-4 sm:px-6 md:space-y-36" aria-label="Gallery, plate ii">
		{
			plateII.map((row, k) =>
				'wide' in row ? (
					<div class="grid md:grid-cols-12">
						<Figure
							class={wideClass(k)}
							src={row.wide.src}
							alt={`${p.name}, ${row.wide.caption}`}
							fig={fig(row.n)}
							caption={row.wide.caption}
							ratio="16/9"
							video={row.wide.kind === 'video'}
							poster={row.wide.poster}
							browser={row.wide.kind === 'browser' ? domain : undefined}
						/>
					</div>
				) : (
					<div class="grid grid-cols-2 gap-3 md:grid-cols-12 md:gap-6">
						{row.tall.map((plate, j) => (
							<Figure
								class:list={[tallClass(row.tall.length, j), row.tall.length === 3 && j === 2 && 'col-span-2 mx-auto w-1/2 md:w-auto']}
								src={plate.src}
								alt={`${p.name}, ${plate.caption}`}
								fig={fig(row.n + j)}
								caption={plate.caption}
								ratio="4/5"
							/>
						))}
					</div>
				),
			)
		}
		<!-- Planche de matière : typographie et couleurs -->
		{!p.media && (
		<figure class="grid gap-6 md:grid-cols-12" data-reveal>
			<div class="plate relative flex min-h-[420px] flex-col justify-between overflow-hidden p-6 md:col-span-7" style={`background:${p.visual.bg}`}>
				<p class="meta flex justify-between text-bone/60"><span>Type specimen</span><span>Parceh / Instrument Sans</span></p>
				<p class="titre text-[clamp(7rem,18vw,16rem)] text-bone">Aa</p>
				<p class="titre text-[clamp(2rem,4vw,3.6rem)]" style={`color:${p.visual.accent}`}>{p.name}</p>
			</div>
			<ul class="grid grid-cols-2 gap-3 md:col-span-5">
				{
					palette.map((c) => (
						<li class="swatch flex aspect-square flex-col justify-end p-3" style={`background:${c.hex}`}>
							<span class="meta text-bone mix-blend-difference">{c.name}</span>
							<span class="meta tabular-nums text-bone/70 mix-blend-difference">{c.hex.toUpperCase()}</span>
						</li>
					))
				}
			</ul>
			<figcaption class="meta text-mineral md:col-span-12"><span class="text-bone/85">fig. {fig(platesOf(p).length + 1)}</span> — matter: type and colour</figcaption>
		</figure>
		)}

	</section>

	<canvas class="pointer-events-none mt-24 block h-28 w-full opacity-60" data-ascii data-ascii-kind="roots" data-ascii-seed={p.visual.seed + 9} data-ascii-size="10" aria-hidden="true"></canvas>

	<!-- Services et résultats -->
	<section class="grid gap-x-6 gap-y-16 px-4 py-24 sm:px-6 md:grid-cols-12 md:py-32">
		<div class="md:col-span-4" data-reveal>
			<p class="meta mb-5 text-mineral"><span data-scramble>[ 04 ] Services</span></p>
			<ul class="meta flex flex-wrap gap-x-3 gap-y-2 text-bone/85">
				{p.services.map((s) => <li><span class="text-mineral-dim">[</span> {s} <span class="text-mineral-dim">]</span></li>)}
			</ul>
		</div>
		{
			p.results && (
				<div class="md:col-span-7 md:col-start-6" data-reveal style="--reveal-delay: 120ms">
					<p class="meta mb-5 text-mineral"><span data-scramble>[ 05 ] Results</span></p>
					<dl class="grid gap-6 sm:grid-cols-3">
						{p.results.map((r) => (
							<div class="flex flex-col border-t border-dashed border-bone/15 pt-5">
								<dt class="meta order-2 mt-2 text-mineral">{r.label}</dt>
								<dd class="text-[clamp(2.4rem,4vw,3.6rem)] leading-none tracking-[-0.03em] text-bone">{r.value}</dd>
							</div>
						))}
					</dl>
				</div>
			)
		}
	</section>

	<Footer />
	<NextSpecimen next={next} />
</Layout>

<style>
	.plate {
		border: 1px solid rgb(230 228 220 / 0.12);
		background-color: var(--color-deep);
	}
	.swatch {
		border: 1px solid rgb(230 228 220 / 0.12);
	}
</style>
